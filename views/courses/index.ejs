<% layout('/layouts/boilerplate')%>
<link rel="stylesheet" href="/stylesheets/course-pages.css">

<%
  const totalCourses = Array.isArray(courses) ? courses.length : 0;
  const topicMap = new Map();
  (courses || []).forEach((course) => {
    const topic = course.topic || 'Course';
    topicMap.set(topic, (topicMap.get(topic) || 0) + 1);
  });
  const topTopics = Array.from(topicMap.entries()).slice(0, 5);
%>

<div class="course-discovery-page">
  <div class="discovery-shell discovery-shell-compact">
    <section class="discovery-hero discovery-hero-library">
      <div>
        <span class="discovery-eyebrow">My learning</span>
        <h1 class="discovery-title">Ti?p t?c h?c t? noi b?n dã d?ng l?i</h1>
        <p class="discovery-lead">Danh sách khóa h?c du?c trình bày g?n hon, t?p trung vào thumbnail, title và hành d?ng ti?p t?c h?c gi?ng phong cách thu vi?n khóa h?c th?c d?ng.</p>

        <div class="discovery-stats">
          <div class="discovery-stat">
            <span class="discovery-stat-value"><%= totalCourses %></span>
            <span class="discovery-stat-label">Khóa h?c dã dang ký</span>
          </div>
          <div class="discovery-stat">
            <span class="discovery-stat-value"><%= topTopics.length %></span>
            <span class="discovery-stat-label">Ch? d? dang theo h?c</span>
          </div>
          <div class="discovery-stat">
            <span class="discovery-stat-value">Now</span>
            <span class="discovery-stat-label">Ti?p t?c h?c ch? v?i m?t l?n b?m</span>
          </div>
        </div>

        <% if (topTopics.length) { %>
          <div class="library-topic-row">
            <% topTopics.forEach(([topic, count]) => { %>
              <span class="library-topic-chip"><%= topic %> <strong><%= count %></strong></span>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>

    <section class="topic-section">
      <div class="topic-head">
        <div>
          <h2 class="topic-title">Khóa h?c dã dang ký</h2>
          <div class="topic-meta"><%= totalCourses %> khóa h?c trong thu vi?n h?c t?p c?a b?n</div>
        </div>
      </div>

      <% if (!totalCourses) { %>
        <div class="alert alert-light border">B?n chua dang ký khóa h?c nào.</div>
      <% } else { %>
        <div class="course-card-grid course-card-grid-library">
          <% courses.forEach((course) => { %>
            <article class="course-discovery-card course-library-card">
              <div class="course-card-media">
                <img src="<%= course.images && course.images.length ? course.images[0].url : '/default.png' %>" alt="<%= course.title %>">
              </div>

              <div class="course-card-body">
                <h3 class="course-card-title"><%= course.title %></h3>
                <p class="course-card-description">
                  <%= (course.description || 'Ti?p t?c h?c khóa h?c này d? xem n?i dung chi ti?t và ti?n d? hi?n t?i c?a b?n.').slice(0, 140) %><%= course.description && course.description.length > 140 ? '...' : '' %>
                </p>

                <div class="course-card-rating course-card-rating-compact">
                  <span class="course-card-topic"><%= course.topic || 'Course' %></span>
                </div>

                <div class="course-card-footer">
                  <a class="btn btn-primary" href="/courses/<%= course._id %>">Ti?p t?c h?c</a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>
</div>

<script>
  const courses = { features: <%- JSON.stringify(courses) %> };
</script>
