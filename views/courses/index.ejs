<% layout('/layouts/boilerplate')%>
<link rel="stylesheet" href="/stylesheets/course-pages.css">

<%
  const totalCourses = Array.isArray(courses) ? courses.length : 0;
  const topicMap = new Map();
  const searchCourses = (courses || []).map((course) => ({
    id: String(course._id),
    title: course.title,
    url: `/courses/${course._id}`,
    thumbnailUrl: course.images && course.images.length ? course.images[0].url : '/default.png',
    topic: course.topic || 'Course'
  }));
  (courses || []).forEach((course) => {
    const topic = course.topic || 'Course';
    topicMap.set(topic, (topicMap.get(topic) || 0) + 1);
  });
  const topTopics = Array.from(topicMap.entries()).slice(0, 5);
%>

<div class="course-discovery-page">
  <div class="discovery-shell discovery-shell-compact">
    <section class="discovery-hero discovery-hero-library">
      <div>
        <span class="discovery-eyebrow">My learning</span>
        <h1 class="discovery-title">Tiếp tục học từ nơi bạn đã dừng lại</h1>
        <p class="discovery-lead">Mỗi lần quay lại là một bước tiến mới, tiếp tục học đều hôm nay để kỹ năng của bạn mạnh hơn từng ngày.</p>

        <div class="discovery-stats">
          <div class="discovery-stat">
            <span class="discovery-stat-value"><%= totalCourses %></span>
            <span class="discovery-stat-label">Khóa học đã đăng ký</span>
          </div>
          <div class="discovery-stat">
            <span class="discovery-stat-value"><%= topTopics.length %></span>
            <span class="discovery-stat-label">Chủ đề đang theo học</span>
          </div>
          <div class="discovery-stat">
            <span class="discovery-stat-value">Now</span>
            <span class="discovery-stat-label">Tiếp tục học chỉ với một lần bấm</span>
          </div>
        </div>

        <% if (topTopics.length) { %>
          <div class="library-topic-row">
            <% topTopics.forEach(([topic, count]) => { %>
              <span class="library-topic-chip"><%= topic %> <strong><%= count %></strong></span>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>

    <section class="topic-section">
      <div class="topic-head">
        <div>
          <h2 class="topic-title">Khóa học đã đăng ký</h2>
          <div class="topic-meta"><%= totalCourses %> khóa học trong thư viện học tập của bạn</div>
        </div>

        <% if (totalCourses) { %>
          <div
            class="course-search-shell"
            data-course-search-root
            data-search-data-id="my-courses-search-data"
            data-search-card-selector="[data-course-card]"
            data-search-empty-selector="#myCoursesSearchEmpty"
            data-search-no-results="No matching courses"
          >
            <label class="visually-hidden" for="myCoursesSearchInput">Search your courses</label>
            <div class="course-search-input-wrap">
              <span class="course-search-icon" aria-hidden="true">⌕</span>
              <input
                id="myCoursesSearchInput"
                class="course-search-input"
                type="search"
                placeholder="Search your courses..."
                autocomplete="off"
                spellcheck="false"
                aria-autocomplete="list"
                aria-expanded="false"
                data-course-search-input
              >
            </div>
            <div class="course-search-dropdown" data-course-search-dropdown hidden></div>
          </div>
        <% } %>
      </div>

      <% if (!totalCourses) { %>
        <div class="alert alert-light border">Bạn chưa đăng ký khóa học nào.</div>
      <% } else { %>
        <div
          class="alert alert-light border course-search-empty-state"
          id="myCoursesSearchEmpty"
          hidden
        >
          Không tìm thấy khóa học phù hợp.
        </div>

        <div class="course-card-grid course-card-grid-library">
          <% courses.forEach((course) => { %>
            <article
              class="course-discovery-card course-library-card"
              data-course-card
              data-search-title="<%= course.title %>"
              data-search-topic="<%= course.topic || 'Course' %>"
            >
              <div class="course-card-media">
                <img src="<%= course.images && course.images.length ? course.images[0].url : '/default.png' %>" alt="<%= course.title %>">
              </div>

              <div class="course-card-body">
                <h3 class="course-card-title"><%= course.title %></h3>
                <p class="course-card-description">
                  <%= (course.description || 'Tiếp tục học khóa học này để xem nội dung chi tiết và tiến độ hiện tại của bạn.').slice(0, 140) %><%= course.description && course.description.length > 140 ? '...' : '' %>
                </p>

                <div class="course-card-rating course-card-rating-compact">
                  <span class="course-card-topic"><%= course.topic || 'Course' %></span>
                </div>

                <div class="course-card-footer">
                  <a class="btn btn-primary" href="/courses/<%= course._id %>">Tiếp tục học</a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>
</div>

<script id="my-courses-search-data" type="application/json"><%- JSON.stringify(searchCourses) %></script>
<script src="/javascripts/course-search.js"></script>
