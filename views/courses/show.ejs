<% layout('/layouts/boilerplate')%>
<link rel="stylesheet" href="/stylesheets/course-pages.css">
<link rel="stylesheet" href="/stylesheets/stars.css">

<div class="learning-root">
  <div class="learning-layout">
  <main class="learning-content" id="content">
    <% if (courseStatusNotice) { %>
      <div id="courseStatusNotice" class="alert alert-warning alert-dismissible fade show m-3 mb-0" role="alert">
        <%= courseStatusNotice %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <section class="learning-stage-shell">
      <header class="learning-stage-header">
        <div class="learning-stage-copy">
          <span class="learning-stage-kicker">Now Learning</span>
          <h1 class="learning-stage-title" id="learningStageCourseTitle"><%= course.title %></h1>
          <div class="learning-stage-meta">
            <span class="learning-stage-badge" id="learningStageLessonType">Course</span>
            <span class="learning-stage-current" id="learningStageLessonTitle">Select a lesson from the course outline.</span>
          </div>
        </div>
        <div class="learning-stage-actions">
          <button class="btn btn-secondary" type="button" data-stage-nav="prev">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Previous</span>
          </button>
          <button class="btn btn-primary" type="button" data-stage-nav="next">
            <span>Next</span>
            <i class="fa-solid fa-arrow-right"></i>
          </button>
        </div>
      </header>

      <div class="lesson-video-shell">
        <div class="lesson-video-frame">
          <div id="videoPlayerContainer" class="video-player-shell video-player-shell-hidden mb-3">
            <iframe id="videoIframe" src="" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
            <video id="html5VideoPlayer" controls playsinline webkit-playsinline="true" controlslist="noremoteplayback" disablepictureinpicture class="lesson-video-html5-player"></video>
            <button id="interactiveQuizHotspot" class="interactive-quiz-hotspot" type="button" aria-label="Open interactive quiz">
              <i class="fa-solid fa-circle-question" aria-hidden="true"></i>
            </button>
          </div>
          <div id="videoProviderNotice" class="small mb-3 video-provider-notice-hidden"></div>
        </div>
      </div>
    </section>

    <section class="learning-support-shell">
      <div class="learning-support-head">
        <div>
          <h2>Course Support</h2>
          <p>Reference material, notes, reviews, and course discussions live here.</p>
        </div>
      </div>

      <div class="course-tabs-wrap">
        <div class="course-tabs">
          <button class="tab-btn active" type="button" data-tab="overview">Overview</button>
          <button class="tab-btn" type="button" data-tab="notes">Notes</button>
          <button class="tab-btn" type="button" data-tab="reviews">Reviews</button>
          <button class="tab-btn" type="button" data-tab="discussions">Discussions</button>
        </div>
        <div class="tab-content">
          <div id="tab-overview" class="tab-pane active">
            <div class="card mb-3 support-panel-card" id="courseInfo">
              <div class="card-body support-overview-grid">
                <div class="support-overview-copy">
                  <h5 class="card-title"><%= course.title %></h5>
                  <p class="card-text"><%= course.description %></p>
                </div>
                <div class="support-overview-media">
                  <% if (course.images && course.images.length > 0) { %>
                    <img src="<%= course.images[0].url %>" alt="<%= course.title %> cover image">
                  <% } else { %>
                    <div class="support-overview-placeholder">
                      <i class="fa-solid fa-book-open-reader"></i>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
          <div id="tab-notes" class="tab-pane">
            <div class="card mb-3 support-panel-card" id="videoNoteSection">
              <div class="card-body">
                <h5 class="card-title">Lesson Notes</h5>
                <% (course.sections || []).forEach((section, index) => { %>
                  <textarea class="form-control section-note section-note-hidden"
                    id="note-section-<%= index %>"
                    rows="5"
                    placeholder="Enter notes for <%= section.title %>..."
                    onblur="saveNote(<%= index %>)"
                    ><%= sectionNotes[index] || '' %></textarea>
                <% }) %>
              </div>
            </div>
          </div>
          <div id="tab-reviews" class="tab-pane">
            <div class="card mb-3 support-panel-card">
              <div class="card-body">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                  <h5 class="mb-0">Student Reviews</h5>
                  <span id="ratingSummary" class="text-muted">No reviews yet.</span>
                </div>

                <form id="reviewForm" class="mb-3">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-3">
                      <label class="form-label" for="rating">Rating</label>
                      <select id="rating" class="form-select">
                        <option value="">Select rating</option>
                        <option value="5">5 - Excellent</option>
                        <option value="4">4 - Good</option>
                        <option value="3">3 - Average</option>
                        <option value="2">2 - Poor</option>
                        <option value="1">1 - Terrible</option>
                      </select>
                    </div>
                    <div class="col-12 col-md-7">
                      <label class="form-label" for="comment">Comment</label>
                      <textarea id="comment" class="form-control" rows="2" placeholder="Share your experience..."></textarea>
                    </div>
                    <div class="col-12 col-md-2">
                      <button id="reviewSubmitBtn" type="button" class="btn btn-primary w-100">Submit</button>
                    </div>
                  </div>
                </form>

                <div id="review-list"></div>
              </div>
            </div>
          </div>
          <div id="tab-discussions" class="tab-pane">
            <div class="card mb-3 support-panel-card">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                  <h5 class="mb-0">Q&A Discussions</h5>
                  <div class="d-flex gap-2">
                    <a class="btn btn-sm btn-outline-primary" href="/courses/<%= course._id %>/discussions">View All</a>
                    <a class="btn btn-sm btn-primary" href="/courses/<%= course._id %>/discussions/new">Ask Question</a>
                  </div>
                </div>

                <% if (!discussionHighlights || !discussionHighlights.length) { %>
                  <p class="text-muted mb-0">No questions yet. Start the first discussion for this course.</p>
                <% } %>

                <% (discussionHighlights || []).forEach((q) => { %>
                  <div class="border rounded p-2 mb-2">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                      <a href="/courses/<%= course._id %>/discussions/<%= q._id %>"><strong><%= q.title %></strong></a>
                      <span class="badge bg-light text-dark"><%= q.score %> votes</span>
                    </div>
                    <div class="small text-muted mt-1">
                      <span><%= q.answersCount %> answers</span>
                      <span class="ms-2">by <%= q.author && q.author.username ? q.author.username : 'User' %></span>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Reflection / Exit Ticket root (used by reflection.js for courseId) -->
    <div id="reflection-learner-root" data-course-id="<%= course._id %>" style="display:none"></div>

  </main>

  <aside class="learning-sidebar">
    <div class="learning-sidebar-inner">
      <% const totalVideos = (course.sections || []).reduce((acc, sec) => acc + ((sec.lessons || []).length), 0); %>
      <% const completedLessonIds = Array.isArray(completedLessons) ? completedLessons : []; %>
      <% const completedCount = completedLessonIds.length; %>
      <% const gm = gamification || { currentLevel: 1, totalXP: 0, currentStreak: 0, levelProgress: { progressPercent: 0, nextLevel: 2, xpToNextLevel: 500 } }; %>
      <section class="learner-sidebar-card learner-progress-card">
        <div class="learner-sidebar-card-head">
          <div>
            <h5>Learning Progress</h5>
            <p id="learningProgressLabel"><%= completedCount %> / <%= totalVideos %> lessons completed</p>
          </div>
          <span id="learningProgressPercent" class="app-badge app-badge-topic"><%= totalVideos ? Math.round(completedCount / totalVideos * 100) : 0 %>%</span>
        </div>
        <div class="progress learner-progress-track">
          <div id="learningProgressBar" class="progress-bar bg-success" role="progressbar" data-progress-width="<%= totalVideos ? Math.round(completedCount / totalVideos * 100) : 0 %>"
            aria-valuenow="<%= completedCount %>" aria-valuemin="0" aria-valuemax="<%= totalVideos %>"></div>
        </div>
      </section>

      <section class="card learner-sidebar-card" id="learningGamificationCard">
        <div class="card-body py-3">
          <div class="learner-sidebar-card-head">
            <div>
              <h5>Gamification</h5>
              <p id="gmNextLevelText">
                <% if (gm.levelProgress.nextLevel) { %>
                  <%= gm.levelProgress.xpToNextLevel %> XP to Level <%= gm.levelProgress.nextLevel %>
                <% } else { %>
                  Max level reached
                <% } %>
              </p>
            </div>
            <div class="learner-sidebar-card-tools">
              <span class="app-badge app-badge-xp" id="gmXpValue"><%= gm.totalXP %> XP</span>
              <button
                type="button"
                class="sidebar-collapse-btn"
                id="gamificationCollapseBtn"
                data-target="#learningGamificationBody"
                aria-expanded="true"
                aria-controls="learningGamificationBody"
                aria-label="Collapse gamification panel"
              >
                <i class="fa-solid fa-chevron-up" aria-hidden="true"></i>
              </button>
            </div>
          </div>
          <div id="learningGamificationBody" class="sidebar-collapsible-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h6 class="mb-0">Level <span id="gmLevelValue"><%= gm.currentLevel %></span></h6>
              <span class="small"><i class="fa-solid fa-fire text-danger me-1"></i>Streak: <strong id="gmStreakValue"><%= gm.currentStreak %></strong></span>
            </div>
            <div class="progress progress-thin mb-2">
              <div id="gmLevelProgress" class="progress-bar bg-info" role="progressbar" data-progress-width="<%= gm.levelProgress.progressPercent || 0 %>"></div>
            </div>
            <div class="learner-sidebar-links">
              <a href="/profile" class="btn btn-sm btn-outline-primary">Profile</a>
              <a href="/leaderboard" class="btn btn-sm btn-outline-secondary">Leaderboard</a>
            </div>
          </div>
        </div>
      </section>

      <% if (course.sections && course.sections.length > 0) { %>
        <section class="learner-sidebar-card learning-sections-wrap">
          <div class="learner-sidebar-card-head">
            <div>
              <h5>Course Content</h5>
              <p>Jump between lessons and keep your place.</p>
            </div>
          </div>
          <div class="dashboard-scroll-area learning-sections-scroll">
            <div id="sectionsAccordion" class="sections-accordion">
              <div class="app-loading-state" aria-hidden="true">
                <div class="app-loading-line is-short"></div>
                <div class="app-loading-line"></div>
                <div class="app-loading-line"></div>
              </div>
            </div>
          </div>
        </section>
      <% } %>

    </div>
  </aside>
  </div>
</div>

<button
  id="aiChatToggle"
  class="lesson-ai-floating-button"
  type="button"
  aria-label="Open AI Tutor"
  aria-controls="aiChatPopup"
  aria-expanded="false"
  title="AI Tutor"
>
  <span class="lesson-ai-floating-button-icon" aria-hidden="true">
    <i class="fa-solid fa-robot"></i>
  </span>
  <span class="lesson-ai-floating-button-label">AI Tutor</span>
  <span id="aiChatUnreadIndicator" class="lesson-ai-unread-indicator hidden" aria-hidden="true"></span>
</button>

<div
  id="aiChatPopup"
  class="lesson-ai-widget"
  data-course-id="<%= course._id %>"
  role="dialog"
  aria-modal="false"
  aria-labelledby="lessonAiWidgetTitle"
  aria-hidden="true"
  tabindex="-1"
  hidden
>
  <div class="lesson-ai-widget-shell">
    <div class="lesson-ai-widget-header ai-chat-header lesson-ai-header">
      <div class="lesson-ai-header-copy">
        <h6 id="lessonAiWidgetTitle" class="mb-0">AI Tutor</h6>
        <p class="lesson-ai-widget-subtitle mb-0">Lesson-aware help without leaving the course.</p>
      </div>
      <div class="lesson-ai-widget-header-actions ai-chat-header-actions lesson-ai-header-actions">
        <span class="ai-chat-model-select" id="courseAiModel" data-model="" aria-label="Uses your saved AI settings">Custom BYOK</span>
        <button class="ai-chat-close lesson-ai-widget-close" type="button" data-chat-close aria-label="Close AI Tutor">
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
      </div>
    </div>

    <div class="lesson-ai-widget-actions ai-quick-actions lesson-ai-actions">
      <button class="btn btn-sm btn-outline-secondary lesson-ai-action-btn" type="button" data-ai-action="summarize">Summarize</button>
      <button class="btn btn-sm btn-outline-secondary lesson-ai-action-btn" type="button" data-ai-action="explain">Explain</button>
      <button class="btn btn-sm btn-outline-secondary lesson-ai-action-btn" type="button" data-ai-action="practice">Practice</button>
      <button class="btn btn-sm btn-outline-secondary lesson-ai-action-btn" type="button" data-ai-action="flashcards">Flashcards</button>
    </div>

    <div class="lesson-ai-widget-context lesson-ai-context">
      <div class="lesson-ai-context-row">
        <div id="aiLessonContextSummary" class="lesson-ai-context-summary">Lesson context will appear here.</div>
        <button id="aiContextToggle" class="lesson-ai-context-toggle" type="button" aria-expanded="false">Show context</button>
      </div>
      <div id="aiLessonContextDetails" class="lesson-ai-context-details hidden"></div>
    </div>

    <div id="chatMessages" class="lesson-ai-widget-messages ai-chat-messages lesson-ai-messages" aria-live="polite">
      <div id="aiStatus" class="lesson-ai-status">Ready</div>
      <div id="chatTranscript" class="lesson-ai-transcript"></div>
      <div id="chatTyping" class="ai-typing lesson-ai-typing hidden">AI is answering...</div>
    </div>

    <form id="aiChatComposer" class="lesson-ai-widget-composer ai-chat-input lesson-ai-composer">
      <textarea id="chatInput" class="form-control lesson-ai-input" rows="1" placeholder="Ask about this lesson..." maxlength="800"></textarea>
      <button id="chatSendBtn" class="btn btn-primary lesson-ai-send-btn" type="submit">Send</button>
    </form>
  </div>
</div>

<div id="interactiveQuizModal" class="interactive-quiz-modal" aria-hidden="true">
  <div class="interactive-quiz-backdrop"></div>
  <div class="interactive-quiz-dialog" role="dialog" aria-modal="true" aria-labelledby="interactiveQuizTitle">
    <div class="interactive-quiz-head">
      <div>
        <h5 id="interactiveQuizTitle" class="mb-1">Interactive Checkpoint</h5>
        <p class="mb-0 small text-muted" data-iq-stamp></p>
      </div>
      <span class="badge bg-primary">Video Quiz</span>
    </div>

    <div class="interactive-quiz-body">
      <p class="interactive-quiz-question" data-iq-question></p>
      <div class="interactive-quiz-options" data-iq-options></div>
      <div class="interactive-quiz-feedback" data-iq-feedback></div>
    </div>

    <div class="interactive-quiz-actions">
      <button type="button" class="btn btn-outline-secondary" data-iq-close disabled>Continue Video</button>
      <button type="button" class="btn btn-primary" data-iq-submit disabled>Submit Answer</button>
    </div>
  </div>
</div>

<!-- Reflection / Exit Ticket Modal -->
<style>
  .reflection-gate-modal { position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 24px; }
  .reflection-gate-modal[hidden] { display: none !important; }
  .reflection-gate-backdrop { position: absolute; inset: 0; background: rgba(15, 23, 42, 0.55); }
  .reflection-gate-shell { position: relative; z-index: 1; display: flex; align-items: stretch; justify-content: center; gap: 0; width: min(900px, 96vw); max-height: min(820px, 92vh); }
  .reflection-gate-modal.note-open .reflection-gate-shell { width: min(1180px, 96vw); gap: 22px; }
  .reflection-gate-dialog { position: relative; width: min(900px, 96vw); max-height: min(820px, 92vh); background: #fff; border-radius: 18px; box-shadow: 0 24px 80px rgba(15, 23, 42, 0.28); display: flex; flex-direction: column; overflow: hidden; flex-shrink: 0; }
  .reflection-gate-modal.note-open .reflection-gate-dialog { width: min(760px, 58vw); }
  .reflection-gate-note-panel { width: min(420px, 34vw); max-height: min(820px, 92vh); background: #fff; border-radius: 18px; box-shadow: 0 12px 40px rgba(15, 23, 42, 0.18); display: flex; flex-direction: column; overflow: hidden; flex-shrink: 0; }
  .reflection-gate-note-panel[hidden] { display: none !important; }
  .reflection-gate-note-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 20px; border-bottom: 1px solid #e5e7eb; }
  .reflection-gate-note-header h3 { margin: 0; font-size: 1rem; font-weight: 600; }
  .reflection-gate-note-content { padding: 18px 20px; overflow-y: auto; flex: 1; }
  .reflection-gate-header { display: flex; justify-content: space-between; gap: 16px; padding: 24px 28px 16px; border-bottom: 1px solid #e5e7eb; }
  .reflection-gate-header h2 { margin: 0; font-size: 1.35rem; font-weight: 700; }
  .reflection-gate-header p { margin: 4px 0 0; font-size: 0.88rem; color: #64748b; }
  .reflection-gate-close { background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #94a3b8; padding: 4px 8px; border-radius: 8px; line-height: 1; }
  .reflection-gate-close:hover { background: #f1f5f9; color: #475569; }
  .reflection-gate-body { padding: 24px 28px; overflow-y: auto; flex: 1; }
  .reflection-gate-prompt { padding: 16px; border-radius: 14px; background: #f8fafc; border: 1px solid #e5e7eb; margin-bottom: 18px; }
  .reflection-gate-prompt h3 { margin: 0 0 8px; font-size: 0.92rem; font-weight: 600; color: #334155; }
  .reflection-gate-prompt p { margin: 0; font-size: 0.95rem; line-height: 1.6; color: #1e293b; }
  .reflection-gate-purpose { font-size: 0.82rem; color: #64748b; margin: 8px 0 0; font-style: italic; }
  .reflection-gate-body label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 0.92rem; }
  #reflectionGateAnswer { width: 100%; min-height: 220px; resize: vertical; padding: 14px 16px; border-radius: 12px; border: 1px solid #cbd5e1; font-size: 15px; line-height: 1.6; font-family: inherit; }
  #reflectionGateAnswer:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15); }
  .reflection-gate-min-hint { font-size: 0.82rem; color: #94a3b8; margin: 8px 0 0; }
  .reflection-gate-error { color: #dc2626; font-size: 0.88rem; margin: 8px 0 0; padding: 8px 12px; background: #fef2f2; border-radius: 8px; border: 1px solid #fecaca; }
  .reflection-gate-footer { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 16px 28px 24px; border-top: 1px solid #e5e7eb; }
  .reflection-gate-footer-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .reflection-gate-footer .btn { border-radius: 10px; font-weight: 600; padding: 10px 20px; }
  body.reflection-modal-open { overflow: hidden; }
  @media (max-width: 900px) { .reflection-gate-modal.note-open .reflection-gate-shell { flex-direction: column; width: min(720px, 96vw); overflow-y: auto; } .reflection-gate-modal.note-open .reflection-gate-dialog { width: 100%; max-height: none; } .reflection-gate-note-panel { width: 100%; max-height: none; min-height: 280px; } }
  @media (max-width: 640px) { .reflection-gate-modal { padding: 12px; align-items: stretch; } .reflection-gate-shell { width: 100%; max-height: 96vh; } .reflection-gate-dialog { width: 100%; max-height: 96vh; border-radius: 14px; } .reflection-gate-footer { flex-direction: column; align-items: stretch; } .reflection-gate-footer-actions, #reflectionGateOpenNoteBtn { width: 100%; } .reflection-gate-footer-actions button { flex: 1; } }
</style>
<div id="reflectionGateModal" class="reflection-gate-modal" hidden>
  <div class="reflection-gate-backdrop" id="reflectionGateBackdrop"></div>

  <div class="reflection-gate-shell">
    <div class="reflection-gate-dialog" role="dialog" aria-modal="true" aria-labelledby="reflectionGateTitle">
      <div class="reflection-gate-header">
        <div>
          <h2 id="reflectionGateTitle">Reflection / Exit Ticket</h2>
          <p id="reflectionGateSubtitle">Please complete this reflection before marking the lesson as complete.</p>
        </div>
        <button type="button" id="reflectionGateCloseBtn" class="reflection-gate-close" aria-label="Close">&times;</button>
      </div>
      <div class="reflection-gate-body">
        <div class="reflection-gate-prompt">
          <h3><i class="fa-solid fa-pen-to-square me-1"></i>Prompt</h3>
          <p id="reflectionGatePrompt"></p>
          <p id="reflectionGatePurpose" class="reflection-gate-purpose"></p>
        </div>
        <label for="reflectionGateAnswer">Your Reflection</label>
        <textarea id="reflectionGateAnswer" placeholder="Write your reflection here..."></textarea>
        <p id="reflectionGateMinLength" class="reflection-gate-min-hint"></p>
        <div id="reflectionGateError" class="reflection-gate-error" hidden></div>
      </div>
      <div class="reflection-gate-footer">
        <button type="button" id="reflectionGateOpenNoteBtn" class="btn btn-outline-secondary btn-sm">
          <i class="fa-solid fa-note-sticky me-1"></i><span id="reflectionGateOpenNoteLabel">Open Note</span>
        </button>
        <div class="reflection-gate-footer-actions">
          <button id="reflectionGateCancelBtn" type="button" class="btn btn-outline-secondary">Cancel</button>
          <button id="reflectionGateSkipBtn" type="button" class="btn btn-outline-warning" hidden>
            <i class="fa-solid fa-forward me-1"></i>Skip Reflection
          </button>
          <button id="reflectionGateSubmitBtn" type="button" class="btn btn-primary">
            <i class="fa-solid fa-paper-plane me-1"></i>Submit Reflection
          </button>
        </div>
      </div>
    </div>

    <aside id="reflectionGateNotePanel" class="reflection-gate-note-panel" hidden>
      <div class="reflection-gate-note-header">
        <h3><i class="fa-solid fa-note-sticky me-1"></i>Lesson Notes</h3>
        <button type="button" id="reflectionGateCloseNoteBtn" class="reflection-gate-close" aria-label="Close notes">&times;</button>
      </div>
      <div id="reflectionGateNoteContent" class="reflection-gate-note-content">
        <p class="text-muted small">Loading notes...</p>
      </div>
    </aside>
  </div>
</div>

<!-- Declare variables and load JS -->
<script nonce="<%= cspNonce %>">
  window.__COURSE__ = <%- serializeJson(course) %>;
  window.completedVideos = <%- serializeJson(completedVideos) %>;
  window.completedLessons = <%- serializeJson(completedLessons || []) %>;
  window.sectionNotes = <%- serializeJson(sectionNotes) %>;
  const course = window.__COURSE__;
  const completedVideos = window.completedVideos;
  const completedLessons = window.completedLessons;
  const sectionNotes = window.sectionNotes;
  const hasCourseUpdate = <%- serializeJson(!!hasCourseUpdate) %>;
  window.__GAMIFICATION__ = <%- serializeJson(gamification || null) %>;
</script>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
