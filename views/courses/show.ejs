<% layout('/layouts/boilerplate')%>
<link rel="stylesheet" href="/stylesheets/stars.css">

<div class="learning-root">
  <div class="learning-layout">
  <main class="learning-content" id="content">
    <div id="imageContainer">
      <div id="carouselExample" class="carousel slide">
        <div class="carousel-inner">
          <% course.images.forEach((img, i) =>{ %>
            <div class="carousel-item  <%= i === 0 ? 'active' : ''%>">
              <img src="<%=img.url%>" class="d-block w-100" alt="">
            </div>
          <% }) %>
        </div>
        <% if(course.images.length > 1) {%>
          <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>
        <% } %>
      </div>
    </div>

    <div class="lesson-video-shell">
      <div class="lesson-video-frame">
        <div id="videoPlayerContainer" class="video-player-shell mb-3" style="display: none;">
          <iframe id="videoIframe" src="" allow="autoplay; encrypted-media; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin"></iframe>
          <video id="html5VideoPlayer" controls playsinline webkit-playsinline="true" controlslist="nofullscreen noremoteplayback" disablepictureinpicture style="display:none; width:100%; height:100%; background:#000;"></video>
          <button id="interactiveQuizHotspot" class="interactive-quiz-hotspot" type="button" aria-label="Open interactive quiz" style="display:none;">
            ?
          </button>
        </div>
      </div>
    </div>
    <div id="videoProviderNotice" class="small mb-3" style="display:none;"></div>

    <div class="course-tabs-wrap">
      <div class="course-tabs">
        <button class="tab-btn active" type="button" data-tab="overview">Overview</button>
        <button class="tab-btn" type="button" data-tab="notes">Notes</button>
        <button class="tab-btn" type="button" data-tab="reviews">Reviews</button>
        <button class="tab-btn" type="button" data-tab="discussions">Discussions</button>
      </div>
      <div class="tab-content">
        <div id="tab-overview" class="tab-pane active">
          <div class="card mb-3" id="courseInfo">
            <div class="card-body">
              <h5 class="card-title"><%= course.title %></h5>
              <p class="card-text"><%= course.description %></p>
            </div>

            <% if (currentUser && (course.author.equals(currentUser._id) || isCurrentUserAdmin)) { %>
              <div class="card-body">
                <!-- <form class="d-inline" action="/courses/<%=course._id%>?_method=DELETE" method="POST">
                  <button class="btn btn-danger">Delete</button>
                </form> -->
              </div>
            <% } %>
          </div>
        </div>
        <div id="tab-notes" class="tab-pane">
          <div class="card mb-3" id="videoNoteSection">
            <div class="card-body">
              <h5 class="card-title">Ghi chú buổi học</h5>
              <% (course.sections || []).forEach((section, index) => { %>
                <textarea class="form-control section-note"
                  id="note-section-<%= index %>"
                  rows="5"
                  placeholder="Nhập ghi chú cho <%= section.title %>..."
                  onblur="saveNote(<%= index %>)"
                  style="display:none;"><%= sectionNotes[index] || '' %></textarea>
              <% }) %>
            </div>
          </div>
        </div>
        <div id="tab-reviews" class="tab-pane">
          <div class="card mb-3">
            <div class="card-body">
              <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                <h5 class="mb-0">Student Reviews</h5>
                <span id="ratingSummary" class="text-muted">No reviews yet.</span>
              </div>

              <form id="reviewForm" class="mb-3">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="row g-2 align-items-end">
                  <div class="col-12 col-md-3">
                    <label class="form-label" for="rating">Rating</label>
                    <select id="rating" class="form-select">
                      <option value="">Select rating</option>
                      <option value="5">5 - Excellent</option>
                      <option value="4">4 - Good</option>
                      <option value="3">3 - Average</option>
                      <option value="2">2 - Poor</option>
                      <option value="1">1 - Terrible</option>
                    </select>
                  </div>
                  <div class="col-12 col-md-7">
                    <label class="form-label" for="comment">Comment</label>
                    <textarea id="comment" class="form-control" rows="2" placeholder="Share your experience..."></textarea>
                  </div>
                  <div class="col-12 col-md-2">
                    <button id="reviewSubmitBtn" type="button" class="btn btn-primary w-100">Submit</button>
                  </div>
                </div>
              </form>

              <div id="review-list"></div>
            </div>
          </div>
        </div>
        <div id="tab-discussions" class="tab-pane">
          <div class="card mb-3">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <h5 class="mb-0">Q&A Discussions</h5>
                <div class="d-flex gap-2">
                  <a class="btn btn-sm btn-outline-primary" href="/courses/<%= course._id %>/discussions">View All</a>
                  <a class="btn btn-sm btn-primary" href="/courses/<%= course._id %>/discussions/new">Ask Question</a>
                </div>
              </div>

              <% if (!discussionHighlights || !discussionHighlights.length) { %>
                <p class="text-muted mb-0">No questions yet. Start the first discussion for this course.</p>
              <% } %>

              <% (discussionHighlights || []).forEach((q) => { %>
                <div class="border rounded p-2 mb-2">
                  <div class="d-flex justify-content-between align-items-center gap-2">
                    <a href="/courses/<%= course._id %>/discussions/<%= q._id %>"><strong><%= q.title %></strong></a>
                    <span class="badge bg-light text-dark"><%= q.score %> votes</span>
                  </div>
                  <div class="small text-muted mt-1">
                    <span><%= q.answersCount %> answers</span>
                    <span class="ms-2">by <%= q.author && q.author.username ? q.author.username : 'User' %></span>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <button id="aiChatToggle" class="ai-chat-toggle" type="button" aria-label="Open AI chat">💬</button>
    <div id="aiChatPopup" class="ai-chat-popup hidden" data-course-id="<%= course._id %>">
      <div class="ai-chat-header">
        <div>
          <h6 class="mb-0">AI Assistant</h6>
          <small class="text-muted">Tư vấn theo bài học hiện tại</small>
        </div>
        <div class="ai-chat-header-actions">
          <select id="courseAiModel" class="ai-chat-model-select" aria-label="Choose AI model">
            <option value="llama3.2">llama3.2</option>
            <option value="grok">Grok</option>
            <option value="gpt-5.4">GPT-5.4</option>
          </select>
          <button class="ai-chat-close" type="button" data-chat-close>✖</button>
        </div>
      </div>

      <div class="ai-quick-actions">
        <button class="btn btn-sm btn-outline-secondary" data-ai-quick="Giải thích slide này">Giải thích slide này</button>
        <button class="btn btn-sm btn-outline-secondary" data-ai-quick="Tóm tắt bài học">Tóm tắt bài học</button>
        <button class="btn btn-sm btn-outline-secondary" data-ai-quick="Câu hỏi ôn tập">Câu hỏi ôn tập</button>
      </div>

      <div id="chatMessages" class="ai-chat-messages"></div>

      <div class="ai-chat-input">
        <input id="chatInput" class="form-control" placeholder="Hỏi về bài học..." maxlength="800" />
        <button id="chatSendBtn" class="btn btn-primary">➤</button>
      </div>
      <div id="chatTyping" class="ai-typing" style="display:none;">AI đang trả lời...</div>
      <div class="ai-context" id="aiStatus">Sẵn sàng</div>
    </div>
  </main>

  <aside class="learning-sidebar">
    <div class="learning-sidebar-inner">
    <% const totalVideos = (course.sections || []).reduce((acc, sec) => acc + ((sec.lessons || []).length), 0); %>
    <% const completedCount = completedVideos.length; %>
    <% const gm = gamification || { currentLevel: 1, totalXP: 0, currentStreak: 0, levelProgress: { progressPercent: 0, nextLevel: 2, xpToNextLevel: 500 } }; %>
    <div class="mb-3">
      <h6 class="text-success">Tiến độ học: <%= completedCount %> / <%= totalVideos %> bài học (<%= totalVideos ? Math.round(completedCount / totalVideos * 100) : 0 %>%)</h6>
      <div class="progress">
        <div class="progress-bar bg-success" role="progressbar" style="width: <%= totalVideos ? Math.round(completedCount / totalVideos * 100) : 0 %>%"
          aria-valuenow="<%= completedCount %>" aria-valuemin="0" aria-valuemax="<%= totalVideos %>"></div>
      </div>
    </div>

    <div class="card mb-3" id="learningGamificationCard">
      <div class="card-body py-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h6 class="mb-0">Level <span id="gmLevelValue"><%= gm.currentLevel %></span></h6>
          <span class="badge bg-primary" id="gmXpValue"><%= gm.totalXP %> XP</span>
        </div>
        <div class="progress mb-2" style="height: 8px;">
          <div id="gmLevelProgress" class="progress-bar bg-info" role="progressbar" style="width: <%= gm.levelProgress.progressPercent || 0 %>%"></div>
        </div>
        <div class="small text-muted mb-2" id="gmNextLevelText">
          <% if (gm.levelProgress.nextLevel) { %>
            <%= gm.levelProgress.xpToNextLevel %> XP to Level <%= gm.levelProgress.nextLevel %>
          <% } else { %>
            Max level reached
          <% } %>
        </div>
        <div class="d-flex justify-content-between align-items-center">
          <span class="small"><i class="fa-solid fa-fire text-danger me-1"></i>Streak: <strong id="gmStreakValue"><%= gm.currentStreak %></strong></span>
          <div class="d-flex gap-2">
            <a href="/profile" class="btn btn-sm btn-outline-primary">Profile</a>
            <a href="/leaderboard" class="btn btn-sm btn-outline-secondary">Leaderboard</a>
          </div>
        </div>
      </div>
    </div>

    <% if (course.sections && course.sections.length > 0) { %>
      <div class="learning-sections-wrap">
        <h5 class="mb-3">Course Content</h5>
        <div id="sectionsAccordion" class="sections-accordion">
          <p class="text-muted">Loading sections...</p>
        </div>
      </div>
    <% } %>
    </div>
  </aside>
  </div>
</div>

<div id="interactiveQuizModal" class="interactive-quiz-modal" aria-hidden="true">
  <div class="interactive-quiz-backdrop"></div>
  <div class="interactive-quiz-dialog" role="dialog" aria-modal="true" aria-labelledby="interactiveQuizTitle">
    <div class="interactive-quiz-head">
      <div>
        <h5 id="interactiveQuizTitle" class="mb-1">Interactive Checkpoint</h5>
        <p class="mb-0 small text-muted" data-iq-stamp></p>
      </div>
      <span class="badge bg-primary">Video Quiz</span>
    </div>

    <div class="interactive-quiz-body">
      <p class="interactive-quiz-question" data-iq-question></p>
      <div class="interactive-quiz-options" data-iq-options></div>
      <div class="interactive-quiz-feedback" data-iq-feedback></div>
    </div>

    <div class="interactive-quiz-actions">
      <button type="button" class="btn btn-outline-secondary" data-iq-close disabled>Continue Video</button>
      <button type="button" class="btn btn-primary" data-iq-submit disabled>Submit Answer</button>
    </div>
  </div>
</div>

<!-- Khai báo biến và load JS -->
<script>
  window.__COURSE__ = <%- serializeJson(course) %>;
  window.completedVideos = <%- serializeJson(completedVideos) %>;
  window.sectionNotes = <%- serializeJson(sectionNotes) %>;
  const course = window.__COURSE__;
  const completedVideos = window.completedVideos;
  const sectionNotes = window.sectionNotes;
  const hasCourseUpdate = <%- serializeJson(!!hasCourseUpdate) %>;
  window.__GAMIFICATION__ = <%- serializeJson(gamification || null) %>;
</script>
<script src="https://www.youtube.com/iframe_api"></script>
<script src="/javascripts/show/store.js" defer></script>
<script src="/javascripts/show/render.js" defer></script>
<script src="/javascripts/show/app.js" defer></script>
<script src="/javascripts/show/aiChat.js" defer></script>

