<% layout(false) %>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= course.title %> - Learning</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="/stylesheets/learning.css">
</head>

<body class="learn-page">
    <div class="learning-shell">
        <header class="learning-topbar">
            <div class="topbar-left">
                <a class="back-link" href="/courses/<%= course._id %>" aria-label="Back to course">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="course-title"><%= course.title %></h1>
                    <div id="lessonTitleLive" class="lesson-title-live">Select a lesson</div>
                </div>
            </div>
            <div class="topbar-right">
                <span id="lessonProgressMeta" class="progress-meta">Lesson 0 / 0</span>
                <div class="progress-track">
                    <div id="lessonProgressFill" class="progress-fill"></div>
                </div>
            </div>
        </header>

        <div class="learning-layout">
            <aside class="learning-sidebar">
                <div class="sidebar-head">Course Content</div>
                <div id="sidebarContent" class="sidebar-scroll"></div>
            </aside>

            <main class="learning-main">
                <div class="main-content">
                    <section id="contentStage" class="content-stage"></section>
                </div>
            </main>
        </div>
    </div>

    <script id="learn-data" type="application/json"><%- JSON.stringify(course) %></script>
    <script src="/javascripts/learning.js"></script>
</body>

</html>
