<% layout('/layouts/boilerplate') %>

<%
  const courseForm = formData || {};
  const thumbnailMode = courseForm.thumbnailMode || 'upload';
  const imageUrl = courseForm.imageUrl || '';
  const importSource = courseForm.importSource || 'drive';
%>

<div class="course-form-page py-4">
  <div class="row g-4 justify-content-center">
    <div class="col-12 col-xl-8">
      <div class="card border-0 shadow-sm course-form-card">
        <div class="card-body p-4 p-lg-5">
          <div class="mb-4">
            <h1 class="h3 mb-2">New Course</h1>
            <p class="text-muted mb-0">Create a course and choose a thumbnail from your device or an external image URL.</p>
          </div>

          <form action="/courses" method="POST" novalidate class="validated-form" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="course[sectionsJson]" id="youtubeSectionsJson" value="<%= courseForm.sectionsJson || '' %>">
            <div class="mb-3">
              <label class="form-label" for="title">Title</label>
              <input
                class="form-control"
                type="text"
                id="title"
                name="course[title]"
                value="<%= courseForm.title || '' %>"
                required
              >
              <div class="valid-feedback">Valid!</div>
            </div>

            <section class="card border-0 shadow-sm mb-4 youtube-import-card" data-youtube-import-root data-import-mode="create">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                  <div>
                    <h2 class="h5 mb-1">Import Source</h2>
                    <p class="text-muted mb-0">Choose Google Drive or import a YouTube playlist and organize it into sections.</p>
                  </div>
                </div>

                <div class="youtube-import-source-switch mb-3">
                  <input class="btn-check" type="radio" name="course[importSource]" id="importSourceDrive" value="drive" autocomplete="off" data-import-source-input <%= importSource === 'youtube' ? '' : 'checked' %>>
                  <label class="btn btn-outline-secondary" for="importSourceDrive">Google Drive</label>

                  <input class="btn-check" type="radio" name="course[importSource]" id="importSourceYoutube" value="youtube" autocomplete="off" data-import-source-input <%= importSource === 'youtube' ? 'checked' : '' %>>
                  <label class="btn btn-outline-secondary" for="importSourceYoutube">YouTube Playlist</label>
                </div>

                <div data-import-panel="drive" class="<%= importSource === 'youtube' ? 'd-none' : '' %>">
                  <label class="form-label" for="driveLink">Drive Link</label>
                  <input
                    class="form-control"
                    type="text"
                    id="driveLink"
                    name="course[driveLink]"
                    value="<%= courseForm.driveLink || '' %>"
                    <%= importSource === 'youtube' ? '' : 'required' %>
                  >
                  <div class="form-text">Paste a Google Drive folder link to scan lessons automatically.</div>
                </div>

                <div data-import-panel="youtube" class="<%= importSource === 'youtube' ? '' : 'd-none' %>">
                  <label class="form-label" for="youtubePlaylistUrl">YouTube Playlist URL</label>
                  <div class="input-group">
                    <input
                      class="form-control"
                      type="url"
                      id="youtubePlaylistUrl"
                      name="course[youtubePlaylistUrl]"
                      value="<%= courseForm.youtubePlaylistUrl || '' %>"
                      placeholder="https://www.youtube.com/playlist?list=..."
                      data-youtube-playlist-url
                    >
                    <button class="btn btn-outline-primary" type="button" data-youtube-preview-btn>Import Playlist</button>
                  </div>
                  <div class="form-text">Supports `playlist?list=...` and watch URLs that contain a `list` parameter.</div>

                  <div class="youtube-import-feedback mt-3 small text-muted" data-youtube-import-status>Paste a playlist URL and import a preview.</div>
                  <div class="youtube-import-preview mt-3 d-none" data-youtube-preview></div>
                </div>
              </div>
            </section>

            <div class="mb-3">
              <label class="form-label" for="topic">Chủ đề</label>
              <select name="course[topic]" id="topic" class="form-control" required>
                <% ['Software', 'Hardware', 'AI', 'Network', 'Language', 'Security', 'Other'].forEach((topic) => { %>
                  <option value="<%= topic %>" <%= courseForm.topic === topic ? 'selected' : '' %>><%= topic %></option>
                <% }) %>
              </select>
            </div>

            <div class="mb-4">
              <%- include('../partials/courseThumbnailField', {
                thumbnailMode,
                imageUrl,
                thumbnailError
              }) %>
            </div>

            <div class="mb-3">
              <label class="form-label" for="description">Description</label>
              <textarea
                class="form-control"
                id="description"
                name="course[description]"
                required
              ><%= courseForm.description || '' %></textarea>
              <div class="valid-feedback">Valid!</div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
              <button class="btn btn-info" type="submit">Create Course</button>
              <a href="/courses" class="btn btn-outline-secondary">Back to Courses</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/javascripts/youtube-course-import.js"></script>
