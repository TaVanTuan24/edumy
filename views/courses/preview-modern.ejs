<% layout('/layouts/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/stars.css">
<link rel="stylesheet" href="/stylesheets/course-pages.css">

<%
  const sections = Array.isArray(course.sections) ? course.sections : [];
  const stats = previewStats || {};
  const totalLessons = Number(stats.totalLessonCount || 0);
  const totalSections = Number(stats.totalSectionCount || sections.length || 0);
  const totalVideos = Number(stats.totalVideoCount || 0);
  const totalDurationLabel = stats.formattedDuration || 'Duration unavailable';
  const summary = reviewSummary || {};
  const totalReviews = Number(summary.reviewCount || 0);
  const averageRating = Number.isFinite(summary.averageRating) ? Number(summary.averageRating).toFixed(1) : null;
  const aiSummary = aiSummaryState || {};
  const aiSummaryText = aiSummary.summary || '';
  const aiSummaryGeneratedAt = aiSummary.generatedAt ? new Date(aiSummary.generatedAt) : null;
  const aiSummaryModel = aiSummary.model || '';
  const hasAiSummary = Boolean(aiSummaryText);

  function itemTypeLabel(item) {
    const type = String((item && item.type) || 'video').toLowerCase();
    if (type === 'slide') return 'Slide';
    if (type === 'quiz') return 'Quiz';
    return 'Video';
  }
%>

<div class="course-show-page course-preview-page">
  <div class="learning-root">
    <section class="show-course-header">
      <div class="show-course-breadcrumb">Course Preview</div>
      <div class="show-course-header-grid">
        <div>
          <h1 class="show-course-title"><%= course.title %></h1>
          <p class="show-course-description"><%= course.description || 'Explore the curriculum preview and course structure below.' %></p>

          <div class="show-course-pills">
            <span class="show-course-pill"><%= totalSections %> sections</span>
            <span class="show-course-pill"><%= totalLessons %> lessons</span>
            <span class="show-course-pill"><%= totalDurationLabel %></span>
            <span class="show-course-pill"><%= totalReviews %> learner reviews</span>
            <% if (averageRating) { %>
              <span class="show-course-pill">Rating <strong><%= averageRating %>/5</strong></span>
            <% } %>
          </div>

          <div class="preview-stats-grid mt-4">
            <div class="preview-stat-card">
              <span class="preview-stat-label">Total course duration</span>
              <strong class="preview-stat-value"><%= totalDurationLabel %></strong>
              <span class="preview-stat-subtext"><%= stats.hasDuration ? 'Loaded from stored course totals' : 'Duration unavailable until synced' %></span>
            </div>
            <div class="preview-stat-card">
              <span class="preview-stat-label">Sections</span>
              <strong class="preview-stat-value"><%= totalSections %></strong>
              <span class="preview-stat-subtext">Structured learning modules</span>
            </div>
            <div class="preview-stat-card">
              <span class="preview-stat-label">Video lessons</span>
              <strong class="preview-stat-value"><%= totalVideos %></strong>
              <span class="preview-stat-subtext"><%= totalLessons %> total lessons in preview</span>
            </div>
          </div>

          <div class="mt-4 d-flex flex-wrap gap-2">
            <% if (isEnrolled) { %>
              <a class="btn btn-success" href="/courses/<%= course._id %>">Vào khóa học</a>
            <% } else { %>
              <form action="/explore/<%= course._id %>/enroll" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-success">Tham gia khóa học</button>
              </form>
            <% } %>
            <a class="btn btn-outline-light" href="/explore">Quay lại explore</a>
          </div>
        </div>

        <div class="show-course-summary-card">
          <h3>Tóm tắt nhanh</h3>
          <div class="show-course-summary-stats">
            <div class="show-course-summary-stat">
              <strong><%= totalSections %></strong>
              <span>Section trong khóa học</span>
            </div>
            <div class="show-course-summary-stat">
              <strong><%= totalLessons %></strong>
              <span>Bài học có thể xem trước</span>
            </div>
            <div class="show-course-summary-stat">
              <strong><%= totalDurationLabel %></strong>
              <span><%= stats.hasDuration ? 'Tổng thời lượng đã được đồng bộ trước đó' : 'Thời lượng chưa khả dụng' %></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="row g-4 align-items-start">
      <div class="col-12 col-lg-8">
        <div class="show-media-panel mb-4">
          <% if (course.images && course.images.length > 0) { %>
            <img src="<%= course.images[0].url %>" alt="<%= course.title %>" class="img-fluid rounded-4 preview-course-thumbnail">
          <% } else { %>
            <img src="/default.png" alt="<%= course.title %>" class="img-fluid rounded-4 preview-course-thumbnail">
          <% } %>
        </div>

        <div class="course-tabs-wrap">
          <div class="tab-content">
            <div class="tab-pane active preview-tab-pane">
              <div class="card show-panel-card mb-4">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                    <div>
                      <h3 class="show-section-title">AI course summary</h3>
                      <p class="show-section-muted mb-0">Summary is loaded from the saved course record in MongoDB.</p>
                    </div>
                    <% if (aiSummaryModel) { %>
                      <span class="badge rounded-pill text-bg-light"><%= aiSummaryModel %></span>
                    <% } %>
                  </div>
                  <% if (!hasAiSummary) { %>
                    <div class="preview-ai-summary-empty mt-3">
                      <strong>AI summary has not been generated for this course yet.</strong>
                      <span>Use the regenerate action if you manage this course.</span>
                    </div>
                  <% } else { %>
                    <div class="preview-ai-summary-copy mt-3 mb-0"><%= aiSummaryText %></div>
                    <% if (aiSummaryGeneratedAt) { %>
                      <div class="preview-ai-summary-note mt-3">
                        Generated by <strong><%= aiSummaryModel || 'AI' %></strong> on <%= aiSummaryGeneratedAt.toLocaleString() %>
                      </div>
                    <% } %>
                  <% } %>
                  <% if (canManageSummary) { %>
                    <div class="preview-ai-summary-actions mt-3">
                      <form action="/courses/<%= course._id %>/ai-summary/regenerate" method="POST" class="d-inline-flex">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn-sm btn-outline-secondary" type="submit">
                          <i class="fa-solid fa-rotate-right"></i>
                          Regenerate summary
                        </button>
                      </form>
                      <% if (aiSummaryNeedsRefresh) { %>
                        <span class="preview-ai-summary-note">Course content changed after the last AI summary.</span>
                      <% } %>
                    </div>
                  <% } %>
                </div>
              </div>

              <div class="card show-panel-card">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
                    <h3 class="show-section-title mb-0">Curriculum Preview</h3>
                  </div>

                  <% if (!sections.length) { %>
                    <p class="text-muted mb-0">Khóa học này chưa có nội dung preview.</p>
                  <% } %>

                  <div class="preview-curriculum-accordion" id="previewCurriculumAccordion">
                    <% sections.forEach((section, sectionIndex) => { %>
                      <div class="preview-section-card">
                        <button
                          class="preview-section-toggle collapsed"
                          type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#preview-section-<%= sectionIndex %>"
                          aria-expanded="false"
                          aria-controls="preview-section-<%= sectionIndex %>"
                        >
                          <div>
                            <div class="small text-uppercase text-muted fw-semibold">Section <%= sectionIndex + 1 %></div>
                            <h4 class="mb-0"><%= section.title || ('Section ' + (sectionIndex + 1)) %></h4>
                          </div>
                          <div class="preview-section-meta">
                            <span class="badge rounded-pill text-bg-light"><%= (section.lessons || []).length %> lessons</span>
                            <span class="preview-section-arrow" aria-hidden="true"><i class="fa-solid fa-chevron-down"></i></span>
                          </div>
                        </button>

                        <div
                          id="preview-section-<%= sectionIndex %>"
                          class="collapse"
                          data-bs-parent="#previewCurriculumAccordion"
                        >
                          <div class="preview-section-body">
                            <% if (!section.lessons || !section.lessons.length) { %>
                              <p class="text-muted mb-0">Chưa có lesson trong section này.</p>
                            <% } else { %>
                              <div class="preview-lesson-list">
                                <% (section.lessons || []).forEach((item, lessonIndex) => { %>
                                  <div class="preview-lesson-item">
                                    <div>
                                      <div class="small text-muted fw-semibold mb-1"><%= itemTypeLabel(item) %> <%= lessonIndex + 1 %></div>
                                      <div class="fw-semibold"><%= item.title || ('Lesson ' + (lessonIndex + 1)) %></div>
                                    </div>
                                    <span class="badge rounded-pill text-bg-secondary"><%= itemTypeLabel(item) %></span>
                                  </div>
                                <% }) %>
                              </div>
                            <% } %>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-lg-4">
        <div class="learning-sidebar-inner">
          <div class="mb-3">
            <h6 class="mb-2">Thông tin nhanh</h6>
            <div class="progress preview-progress">
              <div class="progress-bar bg-success preview-progress-bar" role="progressbar"></div>
            </div>
            <div class="small text-muted mt-2">Toàn bộ curriculum preview đã sẵn sàng để xem.</div>
          </div>

          <div class="card mb-3 preview-cta-card">
            <div class="card-body">
              <div class="small text-uppercase text-muted fw-semibold mb-2">Bắt đầu học</div>
              <h6 class="mb-2">Bạn có thể tham gia trực tiếp từ trang preview.</h6>
              <p class="text-muted small mb-3">Sau khi tham gia, khóa học sẽ xuất hiện trong danh sách học của bạn.</p>
              <% if (isEnrolled) { %>
                <a class="btn btn-success w-100" href="/courses/<%= course._id %>">Vào khóa học</a>
              <% } else { %>
                <form action="/explore/<%= course._id %>/enroll" method="POST" class="d-grid">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-success">Tham gia khóa học</button>
                </form>
              <% } %>
            </div>
          </div>

          <div class="card mb-3" id="learningGamificationCard">
            <div class="card-body py-3">
              <h6 class="mb-3">Highlights</h6>
              <div class="d-grid gap-2 preview-highlights-list">
                <div class="show-course-pill justify-content-between">Sections <strong><%= totalSections %></strong></div>
                <div class="show-course-pill justify-content-between">Duration <strong><%= totalDurationLabel %></strong></div>
                <div class="show-course-pill justify-content-between">Lessons <strong><%= totalLessons %></strong></div>
                <div class="show-course-pill justify-content-between">Videos <strong><%= totalVideos %></strong></div>
                <div class="show-course-pill justify-content-between">Reviews <strong><%= totalReviews %></strong></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
