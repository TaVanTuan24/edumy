<% layout('/layouts/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/course-pages.css">

<%
  const topics = Object.keys(groupedCourses || {});
  const totalCourses = topics.reduce((sum, topic) => sum + groupedCourses[topic].length, 0);
  const searchCourses = topics.flatMap((topic) =>
    groupedCourses[topic].map((course) => ({
      id: String(course._id),
      title: course.title,
      url: `/explore/${course._id}/preview`,
      thumbnailUrl: course.images && course.images.length ? course.images[0].url : '/default.png',
      topic
    }))
  );
%>

<div class="course-discovery-page">
  <div class="discovery-shell">
    <section class="discovery-hero">
      <div>
        <span class="discovery-eyebrow">Explore Learning</span>
        <h1 class="discovery-title">Khám phá khóa học phù hợp cho mục tiêu tiếp theo của bạn</h1>
        <p class="discovery-lead">
          Duyệt theo từng chủ đề, xem nhanh chất lượng khóa học và tìm đúng nội dung bạn muốn học mà không phải đọc qua một danh sách card đơn điệu.
        </p>

        <div class="discovery-stats">
          <div class="discovery-stat">
            <span class="discovery-stat-value"><%= totalCourses %></span>
            <span class="discovery-stat-label">Khóa học đang mở</span>
          </div>
          <div class="discovery-stat">
            <span class="discovery-stat-value"><%= topics.length %></span>
            <span class="discovery-stat-label">Chủ đề đang có</span>
          </div>
          <div class="discovery-stat">
            <span class="discovery-stat-value">Preview</span>
            <span class="discovery-stat-label">Có thể xem trước trước khi tham gia</span>
          </div>
        </div>
      </div>

      <div class="discovery-hero-card">
        <h3>Bắt đầu từ một bài học nhỏ hôm nay</h3>
        <ul class="discovery-checklist">
          <li>Học đều mỗi ngày sẽ tạo ra khác biệt lớn sau vài tháng.</li>
          <li>Mỗi khóa học hoàn thành là một kỹ năng thực tế bạn thật sự sở hữu.</li>
          <li>Bắt đầu ngay với chủ đề khiến bạn tò mò nhất rồi đi tiếp từ đó.</li>
        </ul>
      </div>
    </section>

    <% if (!topics.length) { %>
      <section class="topic-section">
        <div class="alert alert-light border">Chưa có khóa học nào để hiển thị.</div>
      </section>
    <% } else { %>
      <section class="topic-section">
        <div class="topic-head">
          <div>
            <h2 class="topic-title">Tìm khóa học phù hợp nhanh hơn</h2>
            <div class="topic-meta">Gợi ý xuất hiện theo từng ký tự và chỉ tìm trong danh sách Explore hiện tại</div>
          </div>

          <div
            class="course-search-shell course-search-shell-wide"
            data-course-search-root
            data-search-data-id="explore-courses-search-data"
            data-search-card-selector="[data-course-card]"
            data-search-section-selector="[data-search-section]"
            data-search-empty-selector="#exploreCoursesSearchEmpty"
            data-search-no-results="No matching courses"
          >
            <label class="visually-hidden" for="exploreCoursesSearchInput">Search courses</label>
            <div class="course-search-input-wrap">
              <span class="course-search-icon" aria-hidden="true">⌕</span>
              <input
                id="exploreCoursesSearchInput"
                class="course-search-input"
                type="search"
                placeholder="Search courses..."
                autocomplete="off"
                spellcheck="false"
                aria-autocomplete="list"
                aria-expanded="false"
                data-course-search-input
              >
            </div>
            <div class="course-search-dropdown" data-course-search-dropdown hidden></div>
          </div>
        </div>

        <div
          class="alert alert-light border course-search-empty-state"
          id="exploreCoursesSearchEmpty"
          hidden
        >
          Không tìm thấy khóa học phù hợp.
        </div>
      </section>
    <% } %>

    <% topics.forEach((topic) => { %>
      <section class="topic-section" data-search-section>
        <div class="topic-head">
          <div>
            <h2 class="topic-title"><%= topic %></h2>
            <div class="topic-meta"><%= groupedCourses[topic].length %> khóa học trong chủ đề này</div>
          </div>
        </div>

        <div class="course-card-grid">
          <% groupedCourses[topic].forEach((course) => { %>
            <article
              class="course-discovery-card"
              data-course-card
              data-search-title="<%= course.title %>"
              data-search-topic="<%= topic %>"
            >
              <div class="course-card-media">
                <img src="<%= course.images[0]?.url || '/default.png' %>" alt="<%= course.title %>">
                <span class="course-card-badge">Preview available</span>
              </div>

              <div class="course-card-body">
                <h3 class="course-card-title"><%= course.title %></h3>
                <p class="course-card-description">
                  <%= (course.description || '').slice(0, 140) %><%= course.description && course.description.length > 140 ? '...' : '' %>
                </p>

                <div class="course-card-rating">
                  <% if (course.totalReviews > 0) { %>
                    <strong><%= course.avgRating %></strong>
                    <span class="course-rating-stars">
                      <% for (let i = 1; i <= 5; i++) { %>
                        <%= i <= Math.floor(course.avgRating) ? '★' : '☆' %>
                      <% } %>
                    </span>
                    <span class="text-muted small">(<%= course.totalReviews %> reviews)</span>
                  <% } else { %>
                    <span class="text-muted small fst-italic">Chưa có đánh giá</span>
                  <% } %>
                </div>

                <div class="course-card-footer">
                  <span class="course-card-topic"><%= topic %></span>
                  <a href="/explore/<%= course._id %>/preview" class="btn btn-primary">Xem preview</a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      </section>
    <% }) %>
  </div>
</div>

<script id="explore-courses-search-data" type="application/json"><%- serializeJson(searchCourses) %></script>
<script src="/javascripts/course-search.js"></script>
