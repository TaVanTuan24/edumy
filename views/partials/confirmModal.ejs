<div id="appConfirmModal" class="app-confirm-modal" hidden>
  <div class="app-confirm-backdrop" data-confirm-dismiss></div>
  <div
    class="app-confirm-dialog app-modal-shell"
    role="dialog"
    aria-modal="true"
    aria-labelledby="appConfirmTitle"
    aria-describedby="appConfirmMessage"
    data-variant="danger"
  >
    <button type="button" class="app-confirm-close" aria-label="Close confirmation dialog" data-confirm-close>
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
    <div class="app-confirm-header">
      <div class="app-confirm-badge" aria-hidden="true">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <div class="app-confirm-copy">
        <h2 id="appConfirmTitle" class="app-confirm-title">Confirm action</h2>
        <p id="appConfirmMessage" class="app-confirm-message mb-0">Are you sure?</p>
      </div>
    </div>
    <p id="appConfirmWarning" class="app-confirm-warning" hidden></p>
    <div id="appConfirmError" class="app-confirm-error" hidden aria-live="polite"></div>
    <div class="app-confirm-actions">
      <button type="button" class="btn btn-outline-secondary" data-confirm-cancel>Cancel</button>
      <button type="button" class="btn btn-danger" data-confirm-accept>Delete</button>
    </div>
  </div>
</div>

<div id="appToastStack" class="app-toast-stack" aria-live="off" aria-atomic="false"></div>
