<%
  const path = typeof currentPath === 'string' ? currentPath : '';
  const isPath = (value) => path === value;
  const isPathPrefix = (value) => path === value || path.startsWith(value + '/');
%>
<nav class="navbar sticky-top navbar-expand-lg navbar-dark app-navbar" id="appNavbar">
  <div class="container-fluid navbar-shell">
    <a class="navbar-brand" href="/">Edumy</a>
    <button class="navbar-toggler navbar-toggle" id="navbarToggle" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
      aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>
    <div class="collapse navbar-collapse navbar-menu" id="navbarNav">
      <div class="navbar-nav navbar-nav-main navbar-links">
        <a class="nav-link <%= isPath('/') ? 'active' : '' %>" href="/">Home</a>
        <a class="nav-link <%= isPathPrefix('/courses') && !isCurrentUserAdmin ? 'active' : '' %>" href="/courses">Courses</a>
        <a class="nav-link <%= isPathPrefix('/explore') ? 'active' : '' %>" href="/explore">Explore</a>
        <!-- <a class="nav-link" href="/video-models">AI Video Models</a> -->
        <a class="nav-link <%= isPathPrefix('/ai') ? 'active' : '' %>" href="/ai">AI Chat</a>
        <% if (currentUser && isCurrentUserAdmin) { %>
          <a class="nav-link <%= isPathPrefix('/admin') ? 'active' : '' %>" href="/admin">Admin</a>
        <% } %>

        <% if (currentUser && isCurrentUserAdmin) { %>
          <a class="nav-link <%= isPath('/courses/new') ? 'active' : '' %>" href="/courses/new">New Course</a>
        <% } %>
      </div>
      <div class="navbar-nav navbar-actions ms-lg-auto">
        <button
          type="button"
          class="nav-link nav-theme-toggle btn btn-link border-0 bg-transparent"
          data-theme-toggle
          aria-pressed="false"
        >
          <i class="fa-solid fa-moon" data-theme-icon aria-hidden="true"></i>
          <span data-theme-label>Dark</span>
        </button>
        <% if(!currentUser) {%>
          <a class="nav-link <%= isPath('/login') ? 'active' : '' %>" href="/login">Login</a>
          <a class="nav-link <%= isPath('/register') ? 'active' : '' %>" href="/register">Register</a>
        <% } else { %>
          <div class="nav-item dropdown notification-dropdown" data-notification-dropdown>
            <a class="nav-link position-relative" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications" data-notification-trigger>
              <span class="notification-bell" aria-hidden="true"><i class="fa-regular fa-bell"></i></span>
              <% if (courseNotificationCount > 0) { %>
                <span class="notification-badge" data-notification-badge><%= courseNotificationCount %></span>
              <% } %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end notification-menu">
              <% if (courseNotifications && courseNotifications.length > 0) { %>
                <% courseNotifications.forEach((notice) => { %>
                  <li>
                    <a class="dropdown-item notification-item" href="/courses/<%= notice.courseId %>">
                      Course '<%= notice.courseTitle %>' has new updates
                    </a>
                  </li>
                <% }) %>
              <% } else { %>
                <li><span class="dropdown-item-text text-muted">No new updates</span></li>
              <% } %>
            </ul>
          </div>
          <a class="nav-link <%= isPathPrefix('/profile') ? 'active' : '' %>" href="/profile">Profile</a>
          <a class="nav-link <%= isPathPrefix('/leaderboard') ? 'active' : '' %>" href="/leaderboard">Leaderboard</a>
          <form action="/logout" method="POST" class="d-inline m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="nav-link btn btn-link border-0 bg-transparent p-0">Logout</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</nav>
