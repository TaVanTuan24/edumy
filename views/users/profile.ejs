<% layout('/layouts/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/profile.css">

<%
  const avatarUrl = user && user.avatar && user.avatar.url ? user.avatar.url : '';
  const avatarLetter = (user.username || 'U').charAt(0).toUpperCase();
  const recentBadges = gamification.earnedBadges.slice(-3).reverse();
%>

<div class="profile-page container py-4">
  <div class="profile-header-card app-card-elevated">
    <div class="profile-avatar-wrap">
      <% if (avatarUrl) { %>
        <img class="profile-avatar-image" src="<%= avatarUrl %>" alt="Profile photo of <%= user.username %>">
      <% } else { %>
        <div class="profile-avatar" aria-hidden="true"><%= avatarLetter %></div>
      <% } %>

      <form class="profile-avatar-form" action="/profile/avatar" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="avatar-upload-btn" for="profileAvatarInput">Change profile photo</label>
        <input id="profileAvatarInput" class="avatar-upload-input" type="file" name="avatar" accept="image/png,image/jpeg,image/jpg">
        <button id="profileAvatarSubmit" class="btn btn-primary btn-sm" type="submit" disabled>Update photo</button>
      </form>
    </div>

    <div class="profile-header-copy">
      <h1 class="profile-name"><%= user.username %></h1>
      <p class="profile-email mb-1"><%= user.email %></p>
      <p class="profile-meta mb-0">Joined on <%= new Date(user.createdAt || user._id.getTimestamp()).toLocaleDateString('en-US') %></p>
      <div class="profile-actions mt-3">
        <button
          type="button"
          class="btn btn-primary profile-vr-button"
          data-bs-toggle="modal"
          data-bs-target="#vrPairingModal"
        >
          Login VR
        </button>
      </div>

      <% if (recentBadges.length) { %>
        <div class="profile-highlight-badges">
          <% recentBadges.forEach((badge) => { %>
            <span class="profile-highlight-badge"><i class="fa-solid <%= badge.icon %>"></i> <%= badge.name %></span>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <section class="profile-grid mt-4">
    <article class="profile-card app-card">
      <h2>Level Progress</h2>
      <div class="level-row">
        <span class="level-pill app-badge app-badge-status">Level <%= gamification.currentLevel %></span>
        <span class="xp-pill app-badge app-badge-xp"><%= gamification.totalXP %> XP</span>
      </div>
      <div class="xp-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= gamification.levelProgress.progressPercent %>">
        <div id="xpProgressFill" class="xp-fill" data-progress="<%= gamification.levelProgress.progressPercent %>"></div>
      </div>
      <p class="progress-note mb-0">
        <% if (gamification.levelProgress.nextLevel) { %>
          <strong><%= gamification.levelProgress.xpToNextLevel %> XP</strong> until level <%= gamification.levelProgress.nextLevel %>
        <% } else { %>
          You have reached the current maximum level
        <% } %>
      </p>
    </article>

    <article class="profile-card app-card">
      <h2>Learning Streak</h2>
      <div class="streak-row">
        <div class="streak-box">
          <i class="fa-solid fa-fire"></i>
          <div>
            <div class="streak-value"><%= gamification.currentStreak %> days</div>
            <div class="streak-label">Current streak</div>
          </div>
        </div>
        <div class="streak-box muted">
          <i class="fa-solid fa-fire-flame-curved"></i>
          <div>
            <div class="streak-value"><%= gamification.longestStreak %> days</div>
            <div class="streak-label">Longest streak</div>
          </div>
        </div>
      </div>
      <p class="progress-note mb-0">
        <% if (gamification.lastActivityDate) { %>
          Last activity: <strong><%= new Date(gamification.lastActivityDate).toLocaleDateString('en-US', { timeZone: gamification.activityTimezone || 'UTC' }) %></strong>
        <% } else { %>
          Complete your first learning session to start a streak.
        <% } %>
      </p>
    </article>

    <article class="profile-card app-card">
      <h2>Learning Stats</h2>
      <ul class="stat-list">
        <li><span>Total XP</span><strong><%= gamification.totalXP %></strong></li>
        <li><span>Lessons completed</span><strong><%= gamification.completedLessonsCount %></strong></li>
        <li><span>Quizzes completed</span><strong><%= user.gamification && user.gamification.stats ? user.gamification.stats.quizzesCompleted : 0 %></strong></li>
        <li><span>AI interactions</span><strong><%= user.gamification && user.gamification.stats ? user.gamification.stats.aiInteractions : 0 %></strong></li>
        <li><span>Courses completed</span><strong><%= user.gamification && user.gamification.stats ? user.gamification.stats.coursesCompleted : 0 %></strong></li>
      </ul>
    </article>
  </section>

  <section class="profile-card app-card mt-4">
    <div class="badge-head">
      <div>
        <h2 class="mb-0">Badge Collection</h2>
        <p class="badge-subtitle mb-0">Unlock more badges by learning consistently, completing quizzes, and using AI tools.</p>
      </div>
      <span class="badge-count app-badge app-badge-topic"><%= gamification.earnedBadges.length %> / <%= gamification.badges.length %> unlocked</span>
    </div>

    <div class="badge-grid mt-3">
      <% gamification.badges.forEach((badge) => { %>
        <article class="badge-item <%= badge.earned ? 'earned' : 'locked' %>">
          <div class="badge-icon"><i class="fa-solid <%= badge.icon %>"></i></div>
          <div>
            <h3><%= badge.name %></h3>
            <p><%= badge.description %></p>
            <% if (badge.earnedAt) { %>
              <small>Unlocked on <%= new Date(badge.earnedAt).toLocaleDateString('en-US') %></small>
            <% } else { %>
              <small>Not unlocked yet</small>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <section class="profile-card app-card mt-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <h2 class="mb-1">Leaderboard</h2>
        <p class="mb-0 text-muted">See how you rank against other learners.</p>
      </div>
      <a href="/leaderboard" class="btn btn-primary">Open leaderboard</a>
    </div>

    <% if (leaderboard && leaderboard.topUsers && leaderboard.topUsers.length > 0) { %>
      <div class="table-responsive mt-3">
        <table class="table table-sm align-middle mb-0">
          <thead>
            <tr>
              <th>Rank</th>
              <th>Learner</th>
              <th>Level</th>
              <th>XP</th>
            </tr>
          </thead>
          <tbody>
            <% leaderboard.topUsers.forEach((entry) => { %>
              <tr class="<%= entry.isCurrentUser ? 'table-primary' : '' %>">
                <td>#<%= entry.rank %></td>
                <td><%= entry.username %> <%= entry.isCurrentUser ? '(You)' : '' %></td>
                <td><%= entry.level %></td>
                <td><strong><%= entry.totalXP %></strong></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</div>

<div class="modal fade profile-vr-modal" id="vrPairingModal" tabindex="-1" aria-labelledby="vrPairingModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content profile-modal-shell app-modal-shell">
      <div class="modal-header app-modal-head">
        <h5 class="modal-title" id="vrPairingModalLabel">Pair VR Device</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="vrPairingForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-body app-modal-body">
          <label class="form-label fw-semibold" for="vrPairingCodeInput">5-digit pairing PIN</label>
          <input
            id="vrPairingCodeInput"
            class="form-control form-control-lg text-center profile-vr-code-input"
            type="text"
            inputmode="numeric"
            autocomplete="one-time-code"
            maxlength="5"
            pattern="[0-9]{5}"
            placeholder="00000"
          >
          <p class="text-muted small mb-0 mt-2">Open the VR app, request a login code, then enter it here.</p>
          <div id="vrPairingMessage" class="alert d-none mt-3 mb-0" role="alert"></div>
        </div>
        <div class="modal-footer app-modal-actions">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" id="vrPairingSubmit" class="btn btn-primary" disabled>Confirm</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/javascripts/profile.js" defer></script>
