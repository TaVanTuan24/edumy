<% layout('/layouts/boilerplate')%>
<link rel="stylesheet" href="/stylesheets/ai-chat.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">

<section
    class="ai-chat-page"
    data-default-model="<%= defaultAiModel || 'llama3.2' %>"
>
    <aside class="ai-sidebar" id="aiSidebar">
        <div class="ai-sidebar-brand">
            <div>
                <span class="ai-eyebrow">Edumy AI</span>
                <h1>Learning Copilot</h1>
            </div>
            <button class="btn btn-ghost ai-icon-btn ai-mobile-close" id="closeSidebarBtn" type="button" aria-label="Close history">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <button class="btn btn-primary ai-new-chat" id="newChatBtn" type="button">
            <i class="fa-solid fa-plus"></i>
            New conversation
        </button>

        <div class="ai-history-head">
            <span>Recent chats</span>
            <small id="chatCountLabel">0</small>
        </div>
        <div class="ai-history-list" id="chatList">
            <div class="ai-history-empty">Loading conversations...</div>
        </div>
    </aside>

    <div class="ai-sidebar-backdrop" id="sidebarBackdrop"></div>

    <main class="ai-workspace">
        <header class="ai-topbar">
            <div class="ai-topbar-left">
                <button class="btn btn-ghost ai-icon-btn ai-menu-btn" id="openSidebarBtn" type="button" aria-label="Open history">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div>
                    <h2 id="currentChatTitle">New conversation</h2>
                    <span class="ai-chat-subtitle">
                        <span id="headerModelLabel">llama3.2</span>
                        <span>Ask, refine, and keep the thread moving.</span>
                    </span>
                </div>
            </div>

            <div class="ai-topbar-actions">
                <label class="ai-model-picker" for="modelSelect">
                    <span>Model</span>
                    <select id="modelSelect" aria-label="Choose AI model">
                        <% (aiModels || []).forEach((model) => { %>
                            <option
                                value="<%= model.id %>"
                                data-provider="<%= model.provider || '' %>"
                                data-provider-key="<%= model.providerKey || '' %>"
                                <%= model.id === defaultAiModel ? 'selected' : '' %>
                                <%= model.enabled ? '' : 'disabled' %>
                            >
                                <%= model.label %><%= model.enabled ? '' : ' (disabled)' %>
                            </option>
                        <% }) %>
                    </select>
                    <small class="ai-model-endpoint-hint" id="modelEndpointHint" hidden></small>
                </label>
                <button class="btn btn-secondary ai-settings-btn" id="aiSettingsBtn" type="button">
                    <i class="fa-solid fa-gear"></i>
                    AI Settings
                </button>
                <button class="btn btn-secondary ai-secondary-btn" id="headerNewChatBtn" type="button">
                    <i class="fa-regular fa-pen-to-square"></i>
                    New conversation
                </button>
            </div>
        </header>

        <div class="ai-alert is-hidden" id="errorBanner" role="status"></div>

        <section class="ai-conversation" id="conversationPanel">
            <div class="ai-message-list" id="messages">
                <div class="ai-empty-state" id="emptyState">
                    <div class="ai-empty-icon">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                    <p class="ai-eyebrow">Ready when you are</p>
                    <h3>Start a focused learning chat.</h3>
                    <p class="ai-empty-copy">
                        Pick a prompt, or type your own question below.
                    </p>
                    <div class="ai-suggestions">
                        <button type="button" data-suggestion="Explain this topic like I am new to programming.">
                            <strong>Explain clearly</strong>
                            <span>Break down a difficult concept</span>
                        </button>
                        <button type="button" data-suggestion="Create a 7-day study plan for learning JavaScript.">
                            <strong>Build a plan</strong>
                            <span>Turn a goal into steps</span>
                        </button>
                        <button type="button" data-suggestion="Review this code and suggest improvements:">
                            <strong>Review code</strong>
                            <span>Find bugs and improvements</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <footer class="ai-composer-wrap">
            <div class="ai-status-row">
                <span id="conversationModelLabel">Ready - llama3.2</span>
                <button class="btn btn-ghost ai-link-btn" id="regenerateBtn" type="button" disabled>
                    <i class="fa-solid fa-rotate-right"></i>
                    Regenerate last reply
                </button>
            </div>
            <form class="ai-composer" id="chatForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <textarea
                    id="messageInput"
                    rows="1"
                    maxlength="10000"
                    placeholder="Message your AI assistant..."
                    aria-label="Message your AI assistant"
                ></textarea>
                <button id="sendBtn" type="submit" aria-label="Send message">
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </form>
            <p class="ai-composer-hint">Press Enter to send. Use Shift + Enter for a new line.</p>
        </footer>
    </main>
</section>

<div class="ai-settings-modal" id="aiSettingsModal" hidden>
    <div class="ai-settings-dialog app-modal-shell" role="dialog" aria-modal="true" aria-labelledby="aiSettingsTitle">
        <div class="ai-settings-head app-modal-head">
            <div>
                <p class="ai-eyebrow">BYOK</p>
                <h2 id="aiSettingsTitle">AI Settings</h2>
                <span>Add your own API keys and optional Base URLs. Keys are encrypted and never shown again after saving.</span>
            </div>
            <button class="btn btn-ghost ai-icon-btn" id="aiSettingsCloseBtn" type="button" aria-label="Close AI settings">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form class="ai-settings-form app-modal-body" id="aiSettingsForm">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="ai-settings-warning">
                Advanced: Custom Base URL sends your API key and prompts to the configured provider. Only use trusted providers.
            </div>

            <section class="ai-settings-provider" data-provider-card="openai">
                <div class="ai-settings-provider-head">
                    <div>
                        <h3>OpenAI</h3>
                        <p>Example: https://api.openai.com/v1 or an OpenAI-compatible gateway.</p>
                    </div>
                    <div class="ai-settings-provider-status">
                        <small data-key-status="openai">Checking...</small>
                        <small data-base-url-status="openai">Default endpoint</small>
                    </div>
                </div>
                <label class="ai-settings-field">
                    <span>API Key</span>
                    <input type="password" name="openaiKey" autocomplete="off" placeholder="sk-..." />
                </label>
                <label class="ai-settings-field">
                    <span>Base URL</span>
                    <input type="url" name="openaiBaseUrl" autocomplete="off" inputmode="url" placeholder="https://api.openai.com/v1" />
                    <small>Optional. Use this for OpenAI-compatible third-party providers. Leave blank to use official OpenAI API.</small>
                </label>
                <div class="ai-settings-provider-actions">
                    <button type="button" data-clear-key="openai">Clear key</button>
                    <button type="button" data-reset-base-url="openai">Reset to default</button>
                    <button type="button" data-test-provider="openai">Test connection</button>
                </div>
            </section>

            <section class="ai-settings-provider" data-provider-card="xai">
                <div class="ai-settings-provider-head">
                    <div>
                        <h3>xAI / Grok API</h3>
                        <p>Leave blank for official xAI.</p>
                    </div>
                    <div class="ai-settings-provider-status">
                        <small data-key-status="xai">Checking...</small>
                        <small data-base-url-status="xai">Default endpoint</small>
                    </div>
                </div>
                <label class="ai-settings-field">
                    <span>API Key</span>
                    <input type="password" name="xaiKey" autocomplete="off" placeholder="xai-..." />
                </label>
                <label class="ai-settings-field">
                    <span>Base URL</span>
                    <input type="url" name="xaiBaseUrl" autocomplete="off" inputmode="url" placeholder="https://api.x.ai/v1" />
                    <small>Optional. Leave blank to use official xAI API.</small>
                </label>
                <div class="ai-settings-provider-actions">
                    <button type="button" data-clear-key="xai">Clear key</button>
                    <button type="button" data-reset-base-url="xai">Reset to default</button>
                    <button type="button" data-test-provider="xai">Test connection</button>
                </div>
            </section>

            <section class="ai-settings-provider" data-provider-card="claude">
                <div class="ai-settings-provider-head">
                    <div>
                        <h3>Claude</h3>
                        <p>Anthropic-compatible configuration.</p>
                    </div>
                    <div class="ai-settings-provider-status">
                        <small data-key-status="claude">Checking...</small>
                        <small data-base-url-status="claude">Default endpoint</small>
                    </div>
                </div>
                <label class="ai-settings-field">
                    <span>API Key</span>
                    <input type="password" name="claudeKey" autocomplete="off" placeholder="sk-ant-..." />
                </label>
                <label class="ai-settings-field">
                    <span>Base URL</span>
                    <input type="url" name="claudeBaseUrl" autocomplete="off" inputmode="url" placeholder="https://api.anthropic.com/v1" />
                    <small>Optional. Only use if your provider supports Anthropic-compatible APIs.</small>
                </label>
                <div class="ai-settings-provider-actions">
                    <button type="button" data-clear-key="claude">Clear key</button>
                    <button type="button" data-reset-base-url="claude">Reset to default</button>
                    <button type="button" data-test-provider="claude">Test connection</button>
                </div>
            </section>

            <section class="ai-settings-provider" data-provider-card="gemini">
                <div class="ai-settings-provider-head">
                    <div>
                        <h3>Gemini</h3>
                        <p>Google-compatible configuration.</p>
                    </div>
                    <div class="ai-settings-provider-status">
                        <small data-key-status="gemini">Checking...</small>
                        <small data-base-url-status="gemini">Default endpoint</small>
                    </div>
                </div>
                <label class="ai-settings-field">
                    <span>API Key</span>
                    <input type="password" name="geminiKey" autocomplete="off" placeholder="AIza..." />
                </label>
                <label class="ai-settings-field">
                    <span>Base URL</span>
                    <input type="url" name="geminiBaseUrl" autocomplete="off" inputmode="url" placeholder="https://generativelanguage.googleapis.com/v1beta" />
                    <small>Optional. Only use if your provider supports Gemini-compatible APIs.</small>
                </label>
                <div class="ai-settings-provider-actions">
                    <button type="button" data-clear-key="gemini">Clear key</button>
                    <button type="button" data-reset-base-url="gemini">Reset to default</button>
                    <button type="button" data-test-provider="gemini">Test connection</button>
                </div>
            </section>

            <div class="ai-settings-actions">
                <button class="btn btn-primary ai-secondary-btn" type="submit">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Save settings
                </button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/common.min.js"></script>
<script src="/javascripts/ai-chat.js"></script>
