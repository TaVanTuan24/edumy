<% layout('/layouts/boilerplate')%>
<link rel="stylesheet" href="/stylesheets/ai-chat.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">

<section
    class="ai-chat-page"
    data-default-model="<%= defaultAiModel || '' %>"
>
    <aside class="ai-sidebar" id="aiSidebar">
        <div class="ai-sidebar-brand">
            <div>
                <span class="ai-eyebrow">Edumy AI</span>
                <h1>Learning Copilot</h1>
            </div>
            <button class="btn btn-ghost ai-icon-btn ai-mobile-close" id="closeSidebarBtn" type="button" aria-label="Close history">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <button class="btn btn-primary ai-new-chat" id="newChatBtn" type="button">
            <i class="fa-solid fa-plus"></i>
            New conversation
        </button>

        <div class="ai-history-head">
            <span>Recent chats</span>
            <small id="chatCountLabel">0</small>
        </div>
        <div class="ai-history-list" id="chatList">
            <div class="ai-history-empty">Loading conversations...</div>
        </div>
    </aside>

    <div class="ai-sidebar-backdrop" id="sidebarBackdrop"></div>

    <main class="ai-workspace">
        <header class="ai-topbar">
            <div class="ai-topbar-left">
                <button class="btn btn-ghost ai-icon-btn ai-menu-btn" id="openSidebarBtn" type="button" aria-label="Open history">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div>
                    <h2 id="currentChatTitle">New conversation</h2>
                    <span class="ai-chat-subtitle">
                        <span id="headerModelLabel"><%= defaultAiModel || 'No model configured' %></span>
                        <span>Ask, refine, and keep the thread moving.</span>
                    </span>
                </div>
            </div>

            <div class="ai-topbar-actions">
                <label class="ai-model-picker" for="modelSelect">
                        <span>Model</span>
                    <input id="modelSelect" type="text" aria-label="AI model" value="<%= defaultAiModel || '' %>" placeholder="gpt-4o-mini" autocomplete="off">
                    <small class="ai-model-endpoint-hint" id="modelEndpointHint" hidden></small>
                </label>
                <button class="btn btn-secondary ai-settings-btn" id="aiSettingsBtn" type="button">
                    <i class="fa-solid fa-gear"></i>
                    AI Settings
                </button>
                <button class="btn btn-secondary ai-secondary-btn" id="headerNewChatBtn" type="button">
                    <i class="fa-regular fa-pen-to-square"></i>
                    New conversation
                </button>
            </div>
        </header>

        <div class="ai-alert is-hidden" id="errorBanner" role="status"></div>

        <section class="ai-conversation" id="conversationPanel">
            <div class="ai-message-list" id="messages">
                <div class="ai-empty-state" id="emptyState">
                    <div class="ai-empty-icon">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                    <p class="ai-eyebrow">Ready when you are</p>
                    <h3>Start a focused learning chat.</h3>
                    <p class="ai-empty-copy">
                        Pick a prompt, or type your own question below.
                    </p>
                    <div class="ai-suggestions">
                        <button type="button" data-suggestion="Explain this topic like I am new to programming.">
                            <strong>Explain clearly</strong>
                            <span>Break down a difficult concept</span>
                        </button>
                        <button type="button" data-suggestion="Create a 7-day study plan for learning JavaScript.">
                            <strong>Build a plan</strong>
                            <span>Turn a goal into steps</span>
                        </button>
                        <button type="button" data-suggestion="Review this code and suggest improvements:">
                            <strong>Review code</strong>
                            <span>Find bugs and improvements</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <footer class="ai-composer-wrap">
            <div class="ai-status-row">
                <span id="conversationModelLabel">Ready - <%= defaultAiModel || 'No model configured' %></span>
                <button class="btn btn-ghost ai-link-btn" id="regenerateBtn" type="button" disabled>
                    <i class="fa-solid fa-rotate-right"></i>
                    Regenerate last reply
                </button>
            </div>
            <form class="ai-composer" id="chatForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <textarea
                    id="messageInput"
                    rows="1"
                    maxlength="10000"
                    placeholder="Message your AI assistant..."
                    aria-label="Message your AI assistant"
                ></textarea>
                <button id="sendBtn" type="submit" aria-label="Send message">
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </form>
            <p class="ai-composer-hint">Press Enter to send. Use Shift + Enter for a new line.</p>
        </footer>
    </main>
</section>

<div class="ai-settings-modal" id="aiSettingsModal" hidden>
    <div class="ai-settings-dialog app-modal-shell" role="dialog" aria-modal="true" aria-labelledby="aiSettingsTitle">
        <div class="ai-settings-head app-modal-head">
            <div>
                <p class="ai-eyebrow">BYOK</p>
                <h2 id="aiSettingsTitle">AI Settings</h2>
                <span>Use any OpenAI-compatible provider. Your API key is encrypted before storage and will not be shown again after saving.</span>
            </div>
            <button class="btn btn-ghost ai-icon-btn" id="aiSettingsCloseBtn" type="button" aria-label="Close AI settings">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form class="ai-settings-form app-modal-body" id="aiSettingsForm">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="ai-settings-warning">
                Custom Base URL sends your prompts to the configured provider. Only use trusted OpenAI-compatible endpoints.
            </div>

            <section class="ai-settings-provider" data-provider-card="custom">
                <div class="ai-settings-provider-head">
                    <div>
                        <h3>Custom AI provider</h3>
                        <p>Use any OpenAI-compatible provider, gateway, or local endpoint.</p>
                    </div>
                    <div class="ai-settings-provider-status">
                        <small id="aiSettingsKeyStatus">Checking...</small>
                        <small id="aiSettingsBaseUrlStatus">No endpoint configured</small>
                    </div>
                </div>
                <label class="ai-settings-field">
                    <span>Base URL</span>
                    <input type="url" name="baseUrl" autocomplete="off" inputmode="url" placeholder="https://api.openai.com/v1" />
                    <small>Examples: https://api.openai.com/v1, https://openrouter.ai/api/v1, http://localhost:11434/v1</small>
                </label>
                <label class="ai-settings-field">
                    <span>API Key</span>
                    <input type="password" name="apiKey" autocomplete="off" placeholder="Enter a new key or leave blank to keep saved key" />
                    <small id="aiSettingsApiKeyHint">The key will not be shown again after saving.</small>
                </label>
                <label class="ai-settings-field">
                    <span>Model</span>
                    <input type="text" name="model" autocomplete="off" maxlength="200" placeholder="gpt-4o-mini, anthropic/claude-3.5-sonnet, llama3.1" />
                </label>
                <div class="ai-settings-provider-actions">
                    <button type="button" id="aiSettingsDeleteBtn">Delete config</button>
                    <button type="button" id="aiSettingsTestBtn">Test connection</button>
                </div>
            </section>

            <div class="ai-settings-actions">
                <button class="btn btn-primary ai-secondary-btn" type="submit">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Save settings
                </button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/common.min.js"></script>
<script src="/javascripts/ai-chat.js"></script>
