<!DOCTYPE html>
<html lang="en">

<head>
    <script nonce="<%= cspNonce %>">
        (function() {
            var storageKey = 'edumy-theme';
            var root = document.documentElement;
            var theme = 'light';

            try {
                var saved = window.localStorage.getItem(storageKey);
                if (saved === 'dark' || saved === 'light') {
                    theme = saved;
                } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    theme = 'dark';
                }
            } catch (_error) {
                if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    theme = 'dark';
                }
            }

            root.dataset.theme = theme;
            root.style.colorScheme = theme;
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="csrf-token" content="<%= csrfToken || '' %>">
    <title>Edumy</title>
    <link rel="icon" href="data:,">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="/stylesheets/app.css">
    <link rel="stylesheet" href="/stylesheets/app-feedback.css">
    <link rel="stylesheet" href="/stylesheets/app-learning.css">
    <link rel="stylesheet" href="/stylesheets/responsive.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>

<%
    const shellBodyClass = typeof bodyClass !== 'undefined' ? bodyClass : '';
    const shellMainClass = typeof mainClass !== 'undefined' ? mainClass : '';
    const currentPathValue = String(typeof currentPath !== 'undefined' ? currentPath : '');
    let pageTone = 'default';

    if (shellBodyClass.includes('home-page-shell') || currentPathValue === '/') {
        pageTone = 'home';
    } else if (shellBodyClass.includes('ai-chat-shell') || currentPathValue.startsWith('/ai')) {
        pageTone = 'chat';
    } else if (currentPathValue === '/courses') {
        pageTone = 'dashboard';
    } else if (currentPathValue.startsWith('/courses/') && !currentPathValue.includes('/edit')) {
        pageTone = 'player';
    } else if (currentPathValue.startsWith('/admin') || shellMainClass.includes('app-content-full')) {
        pageTone = 'admin';
    }
%>

<body class="app-shell d-flex flex-column min-vh-100 <%= shellBodyClass %>" data-page-tone="<%= pageTone %>">
    <div class="app-background" aria-hidden="true">
        <div class="app-background-gradient"></div>
        <div class="app-background-blobs">
            <span class="app-background-blob app-background-blob-a"></span>
            <span class="app-background-blob app-background-blob-b"></span>
            <span class="app-background-blob app-background-blob-c"></span>
        </div>
        <div class="app-background-noise"></div>
    </div>
    <%- include('../partials/navbar')%>
        <main class="app-main container-fluid p-0 <%= shellMainClass %>">
            <div class="app-page-stage">
            <%- include('../partials/flash')%>
                <%- body %>
            </div>
        </main>
        <% if (!(typeof hideFooter !== 'undefined' && hideFooter)) { %>
            <%- include('../partials/footer')%>
        <% } %>
            <%- include('../partials/confirmModal')%>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
                crossorigin="anonymous"></script>
            <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
                integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
                crossorigin="anonymous"></script>
            <script src="/javascripts/csrf.js" defer></script>
            <script src="/javascripts/confirm.js" defer></script>
            <script src="/javascripts/formatLessonName.js" defer></script>
            <script src="/javascripts/progress-width.js" defer></script>
            <script src="/javascripts/theme.js" defer></script>
            <script src="/javascripts/navbar-notifications.js" defer></script>
            <script src="/javascripts/validateForm.js" defer></script>
            <script src="/javascripts/course-thumbnail-input.js" defer></script>
            <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js" defer></script>
</body>

</html>
