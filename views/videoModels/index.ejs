<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Video Generation Models Directory</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/5.0.0-alpha1/css/bootstrap.min.css"
        integrity="sha384-r4NyP46KrjDleawBgD5tp8Y7UzmLA05oM1iAEQ17CSuDqnUK2+k9luXQOfXJCJ4I" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #6366f1;
            --secondary-color: #8b5cf6;
            --dark-bg: #0f172a;
            --card-bg: #1e293b;
            --text-light: #f8fafc;
            --text-muted: #94a3b8;
        }

        body {
            background: linear-gradient(135deg, var(--dark-bg) 0%, #1a1a2e 100%);
            min-height: 100vh;
            color: var(--text-light);
        }

        .hero-section {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            padding: 4rem 0;
            margin-bottom: 3rem;
            position: relative;
            overflow: hidden;
        }

        .hero-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="none" stroke="white" stroke-width="0.5" opacity="0.1"/></svg>') repeat;
            animation: rotate 20s linear infinite;
        }

        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .model-card {
            background: var(--card-bg);
            border-radius: 16px;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
            height: 100%;
        }

        .model-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(99, 102, 241, 0.3);
        }

        .model-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .model-content {
            padding: 1.5rem;
        }

        .model-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            color: var(--text-light);
        }

        .model-developer {
            color: var(--secondary-color);
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .model-description {
            color: var(--text-muted);
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 1rem;
        }

        .rating-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            background: rgba(99, 102, 241, 0.2);
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.85rem;
            color: #818cf8;
        }

        .pricing-badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            margin-left: 0.5rem;
        }

        .pricing-free {
            background: rgba(34, 197, 94, 0.2);
            color: #22c55e;
        }

        .pricing-freemium {
            background: rgba(59, 130, 246, 0.2);
            color: #3b82f6;
        }

        .pricing-paid {
            background: rgba(245, 158, 11, 0.2);
            color: #f59e0b;
        }

        .pricing-enterprise {
            background: rgba(168, 85, 247, 0.2);
            color: #a855f7;
        }

        .feature-tag {
            display: inline-block;
            background: rgba(99, 102, 241, 0.1);
            color: #818cf8;
            padding: 0.25rem 0.5rem;
            border-radius: 6px;
            font-size: 0.75rem;
            margin: 0.125rem;
            border: 1px solid rgba(99, 102, 241, 0.2);
        }

        .btn-visit {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-visit:hover {
            transform: scale(1.05);
            box-shadow: 0 10px 20px rgba(99, 102, 241, 0.4);
        }

        .section-title {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 1rem;
            background: linear-gradient(135deg, #fff 0%, #a5b4fc 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stats-card {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
        }

        .stats-number {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--primary-color);
        }

        .nav-link-custom {
            color: var(--text-light) !important;
            font-weight: 500;
        }

        .nav-link-custom:hover {
            color: var(--primary-color) !important;
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-transparent">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-robot me-2"></i>Edumy AI
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="/courses">Courses</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="/video-models">AI Video Models</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="/ai">AI Chat</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container text-center position-relative">
            <h1 class="section-title">AI Video Generation Models</h1>
            <p class="lead mb-4" style="font-size: 1.25rem; opacity: 0.9;">
                Discover the best AI-powered video generation tools transforming creative content
            </p>
            <div class="row justify-content-center mt-4">
                <div class="col-md-3">
                    <div class="stats-card">
                        <div class="stats-number"><%= videoModels.length %></div>
                        <div>Models Listed</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stats-card">
                        <div class="stats-number">2024</div>
                        <div>Latest Year</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stats-card">
                        <div class="stats-number">∞</div>
                        <div>Possibilities</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Models Grid -->
    <div class="container mb-5">
        <div class="row g-4">
            <% videoModels.forEach(model => { %>
                <div class="col-md-6 col-lg-4">
                    <div class="model-card">
                        <img src="<%= model.imageUrl %>" alt="<%= model.name %>" class="model-image">
                        <div class="model-content">
                            <h3 class="model-title">
                                <%= model.name %>
                                <span class="pricing-badge pricing-<%= model.pricing.toLowerCase() %>"><%= model.pricing %></span>
                            </h3>
                            <div class="model-developer">
                                <i class="fas fa-building me-1"></i><%= model.developer %>
                            </div>
                            <p class="model-description"><%= model.description %></p>
                            
                            <div class="mb-3">
                                <div class="rating-badge">
                                    <i class="fas fa-star"></i>
                                    <%= model.rating.toFixed(1) %>
                                </div>
                                <span class="text-muted ms-2" style="font-size: 0.85rem;">
                                    <i class="far fa-calendar-alt me-1"></i><%= model.releaseYear %>
                                </span>
                            </div>
                            
                            <div class="mb-3">
                                <% model.features.slice(0, 4).forEach(feature => { %>
                                    <span class="feature-tag"><%= feature %></span>
                                <% }) %>
                            </div>
                            
                            <a href="<%= model.website %>" target="_blank" class="btn btn-visit text-white w-100">
                                <i class="fas fa-external-link-alt me-2"></i>Visit Website
                            </a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-dark py-4 mt-5">
        <div class="container text-center">
            <p class="mb-0 text-muted">&copy; 2025 Edumy. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
