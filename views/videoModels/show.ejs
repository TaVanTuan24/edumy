<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= videoModel.name %> - AI Video Generation Model</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/5.0.0-alpha1/css/bootstrap.min.css"
        integrity="sha384-r4NyP46KrjDleawBgD5tp8Y7UzmLA05oM1iAEQ17CSuDqnUK2+k9luXQOfXJCJ4I" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #6366f1;
            --secondary-color: #8b5cf6;
            --dark-bg: #0f172a;
            --card-bg: #1e293b;
            --text-light: #f8fafc;
            --text-muted: #94a3b8;
        }

        body {
            background: linear-gradient(135deg, var(--dark-bg) 0%, #1a1a2e 100%);
            min-height: 100vh;
            color: var(--text-light);
        }

        .model-header {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            padding: 3rem 0;
        }

        .model-image {
            width: 100%;
            height: 300px;
            object-fit: cover;
            border-radius: 16px;
        }

        .info-card {
            background: var(--card-bg);
            border-radius: 16px;
            padding: 2rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .pricing-badge {
            display: inline-block;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .pricing-free {
            background: rgba(34, 197, 94, 0.2);
            color: #22c55e;
        }

        .pricing-freemium {
            background: rgba(59, 130, 246, 0.2);
            color: #3b82f6;
        }

        .pricing-paid {
            background: rgba(245, 158, 11, 0.2);
            color: #f59e0b;
        }

        .pricing-enterprise {
            background: rgba(168, 85, 247, 0.2);
            color: #a855f7;
        }

        .rating-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(99, 102, 241, 0.2);
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 1rem;
            color: #818cf8;
        }

        .feature-tag {
            display: inline-block;
            background: rgba(99, 102, 241, 0.1);
            color: #818cf8;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-size: 0.9rem;
            margin: 0.25rem;
            border: 1px solid rgba(99, 102, 241, 0.2);
        }

        .btn-visit {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            border: none;
            padding: 1rem 2rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

        .btn-visit:hover {
            transform: scale(1.05);
            box-shadow: 0 10px 20px rgba(99, 102, 241, 0.4);
        }

        .back-link {
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .back-link:hover {
            color: var(--primary-color);
        }

        .nav-link-custom {
            color: var(--text-light) !important;
            font-weight: 500;
        }

        .nav-link-custom:hover {
            color: var(--primary-color) !important;
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-transparent">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-robot me-2"></i>Edumy AI
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="/courses">Courses</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="/video-models">AI Video Models</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="/ai">AI Chat</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Model Header -->
    <section class="model-header">
        <div class="container">
            <a href="/video-models" class="back-link">
                <i class="fas fa-arrow-left me-2"></i>Back to Directory
            </a>
        </div>
    </section>

    <!-- Model Details -->
    <div class="container my-5">
        <div class="row">
            <div class="col-lg-6 mb-4">
                <img src="<%= videoModel.imageUrl %>" alt="<%= videoModel.name %>" class="model-image">
            </div>
            <div class="col-lg-6">
                <div class="info-card">
                    <div class="d-flex align-items-center mb-3">
                        <h1 class="mb-0 me-3"><%= videoModel.name %></h1>
                        <span class="pricing-badge pricing-<%= videoModel.pricing.toLowerCase() %>"><%= videoModel.pricing %></span>
                    </div>
                    
                    <div class="mb-4">
                        <span class="text-muted">
                            <i class="fas fa-building me-2"></i><%= videoModel.developer %>
                        </span>
                        <span class="text-muted ms-3">
                            <i class="far fa-calendar-alt me-2"></i><%= videoModel.releaseYear %>
                        </span>
                    </div>

                    <div class="mb-4">
                        <div class="rating-badge">
                            <i class="fas fa-star"></i>
                            <%= videoModel.rating.toFixed(1) %> / 5.0
                        </div>
                    </div>

                    <p class="lead mb-4"><%= videoModel.description %></p>

                    <h5 class="mb-3">Features</h5>
                    <div class="mb-4">
                        <% videoModel.features.forEach(feature => { %>
                            <span class="feature-tag"><i class="fas fa-check me-1"></i><%= feature %></span>
                        <% }) %>
                    </div>

                    <a href="<%= videoModel.website %>" target="_blank" class="btn btn-visit text-white w-100">
                        <i class="fas fa-external-link-alt me-2"></i>Visit Website
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-dark py-4 mt-5">
        <div class="container text-center">
            <p class="mb-0 text-muted">&copy; 2025 Edumy. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
