<% layout('/layouts/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/discussions.css">

<div class="discussion-shell container py-4">
  <header class="discussion-head mb-3">
    <div>
      <h1 class="mb-1">Course Discussions</h1>
      <p class="text-muted mb-0"><%= course ? course.title : 'Course' %></p>
    </div>
    <a class="btn btn-primary" href="/courses/<%= course._id %>/discussions/new">Ask Question</a>
  </header>

  <form class="discussion-filter card card-body mb-3" method="GET" action="/courses/<%= course._id %>/discussions">
    <div class="row g-2 align-items-end">
      <div class="col-md-4">
        <label class="form-label" for="lessonId">Lesson ID</label>
        <input id="lessonId" name="lessonId" class="form-control" value="<%= query.lessonId || '' %>" placeholder="Optional lesson id">
      </div>
      <div class="col-md-4">
        <label class="form-label" for="tag">Tag</label>
        <input id="tag" name="tag" class="form-control" value="<%= query.tag || '' %>" placeholder="Optional tag">
      </div>
      <div class="col-md-2">
        <label class="form-label" for="sort">Sort</label>
        <select id="sort" name="sort" class="form-select">
          <option value="best" <%= query.sort === 'best' ? 'selected' : '' %>>Best</option>
          <option value="newest" <%= query.sort === 'newest' ? 'selected' : '' %>>Newest</option>
        </select>
      </div>
      <div class="col-md-2">
        <button class="btn btn-outline-primary w-100" type="submit">Apply</button>
      </div>
    </div>
  </form>

  <section class="discussion-list">
    <% if (!questions.length) { %>
      <article class="discussion-item empty">No questions yet. Be the first to ask.</article>
    <% } %>
    <% questions.forEach((item) => { %>
      <article class="discussion-item">
        <div class="vote-col">
          <div class="vote-num"><%= item.score %></div>
          <div class="vote-label">votes</div>
          <div class="ans-num"><%= item.answersCount %></div>
          <div class="vote-label">answers</div>
        </div>
        <div class="content-col">
          <a class="question-link" href="/courses/<%= course._id %>/discussions/<%= item._id %>"><%= item.title %></a>
          <p class="question-snippet"><%= (item.body || '').slice(0, 220) %></p>
          <div class="meta-row">
            <span>by <strong><%= item.author && item.author.username ? item.author.username : 'User' %></strong></span>
            <span><%= new Date(item.createdAt).toLocaleString() %></span>
            <% if (item.tags && item.tags.length) { %>
              <span class="tag-list">
                <% item.tags.forEach((tag) => { %>
                  <span class="tag-pill"><%= tag %></span>
                <% }) %>
              </span>
            <% } %>
          </div>
        </div>
      </article>
    <% }) %>
  </section>
</div>
