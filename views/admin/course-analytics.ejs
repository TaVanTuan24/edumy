<% layout('/layouts/boilerplate')%>
<link rel="stylesheet" href="/stylesheets/analytics.css">

<div class="analytics-container">
    <div class="dashboard-header">
        <div class="dashboard-title">
            <h2>Course Analytics</h2>
            <p class="text-muted"><%= course.title %> &mdash; Insights &amp; Performance</p>
        </div>
        
        <div class="filter-bar">
            <a href="?range=today" class="filter-btn <%= timeRange === 'today' ? 'active' : '' %>">Today</a>
            <a href="?range=7d" class="filter-btn <%= timeRange === '7d' ? 'active' : '' %>">Last 7 Days</a>
            <a href="?range=30d" class="filter-btn <%= timeRange === '30d' ? 'active' : '' %>">Last 30 Days</a>
            <a href="?range=90d" class="filter-btn <%= timeRange === '90d' ? 'active' : '' %>">Last 90 Days</a>
            <a href="?range=all" class="filter-btn <%= timeRange === 'all' ? 'active' : '' %>">All Time</a>
        </div>
    </div>

    <!-- KPI Overview Cards -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-label"><i class="fa-solid fa-users"></i> Enrolled Users</div>
            <div class="kpi-value"><%= analytics.overview.totalEnrolled %></div>
            <div class="kpi-subtext">+<%= analytics.overview.newLearnersCount %> in selected period</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label"><i class="fa-solid fa-bolt"></i> Active Learners</div>
            <div class="kpi-value"><%= analytics.overview.activeLearners %></div>
            <div class="kpi-subtext">Engaged during period</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label"><i class="fa-solid fa-flag-checkered"></i> Completion Rate</div>
            <div class="kpi-value"><%= analytics.overview.completionRate %>%</div>
            <div class="kpi-subtext"><%= analytics.overview.completedLearners %> finished course</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label"><i class="fa-solid fa-clock"></i> Learning Time</div>
            <div class="kpi-value"><%= Math.floor(analytics.overview.totalWatchTime / 60) %>h <%= Math.round(analytics.overview.totalWatchTime % 60) %>m</div>
            <div class="kpi-subtext"><%= analytics.overview.totalLessonViews %> total lesson views</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label"><i class="fa-solid fa-clipboard-question"></i> Avg Quiz Score</div>
            <div class="kpi-value"><%= analytics.overview.avgQuizScore %>%</div>
            <div class="kpi-subtext"><%= analytics.overview.totalQuizAttempts %> attempts</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label"><i class="fa-solid fa-star"></i> Avg Rating</div>
            <div class="kpi-value"><%= analytics.overview.avgRating %> <span class="analytics-rating-star">★</span></div>
            <div class="kpi-subtext"><%= analytics.overview.totalReviews %> reviews</div>
        </div>
    </div>

    <!-- Charts Row 1 -->
    <div class="charts-grid">
        <div class="chart-card col-span-8">
            <div class="chart-header">
                <h5>Learner Activity Trend</h5>
                <span class="text-muted"><i class="fa-solid fa-chart-line"></i> Daily Active Users</span>
            </div>
            <div class="chart-container">
                <div class="chart-loading chart-skeleton">
                    <div class="chart-skeleton-bars"><span></span><span></span><span></span><span></span><span></span></div>
                </div>
                <canvas id="activityTrendChart"></canvas>
            </div>
        </div>

        <div class="chart-card col-span-4">
            <div class="chart-header">
                <h5>Progress Distribution</h5>
                <span class="text-muted"><i class="fa-solid fa-chart-pie"></i> By Completion %</span>
            </div>
            <div class="chart-container">
                <div class="chart-loading chart-skeleton">
                    <div class="chart-skeleton-bars"><span></span><span></span><span></span><span></span><span></span></div>
                </div>
                <canvas id="progressDistChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Charts Row 2 -->
    <div class="charts-grid">
        <div class="chart-card col-span-6">
            <div class="chart-header">
                <h5>Course Funnel</h5>
                <span class="text-muted"><i class="fa-solid fa-filter"></i> Step drop-off</span>
            </div>
            <div class="chart-container">
                <div class="chart-loading chart-skeleton">
                    <div class="chart-skeleton-bars"><span></span><span></span><span></span><span></span><span></span></div>
                </div>
                <canvas id="funnelChart"></canvas>
            </div>
        </div>

        <div class="chart-card col-span-6">
            <div class="chart-header">
                <h5>Top Engaging Lessons</h5>
            </div>
            <div class="analytics-scroll-pane">
                <ul class="custom-list">
                    <% analytics.topLessons.forEach(lesson => { %>
                        <li>
                            <div class="list-title">
                                <%= stripFileExtension(lesson.title) %>
                                <span class="list-subtitle">Lesson ID: <%= lesson.lessonId.substring(0,8) %>...</span>
                            </div>
                            <div class="list-stat-badge"><%= lesson.views %> views</div>
                        </li>
                    <% }); %>
                    <% if (analytics.topLessons.length === 0) { %>
                        <li><span class="text-muted">No lesson interaction data yet.</span></li>
                    <% } %>
                </ul>
            </div>
        </div>
    </div>

    <!-- Learner Table -->
    <div class="table-card mt-4">
        <div class="table-toolbar">
            <h5 class="mb-0">Learner Progress Directory</h5>
            <div class="search-box">
                <i class="fa-solid fa-search"></i>
                <input type="text" id="tableSearch" placeholder="Search by name or email...">
            </div>
        </div>
        <div class="analytics-table-wrap">
            <table class="learners-table">
                <thead>
                    <tr>
                        <th data-sort="name">Learner</th>
                        <th data-sort="progress">Course Progress</th>
                        <th data-sort="score">Quiz Score</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="learnersTableBody">
                    <% analytics.studentRows.forEach(row => { %>
                        <tr data-name="<%= row.name %>" data-progress="<%= row.progress %>" data-score="<%= row.quizScoreAvg %>">
                            <td>
                                <div class="analytics-row-name"><%= row.name %></div>
                                <div class="analytics-row-email"><%= row.email %></div>
                            </td>
                            <td>
                                <div class="progress-bar-container">
                                    <div class="progress-bar-fill" data-progress-width="<%= row.progress %>"></div>
                                </div>
                                <span class="analytics-progress-value"><%= row.progress %>%</span>
                                <div class="analytics-progress-meta"><%= row.completedLessonsCount %> / <%= row.totalLessons %> lessons</div>
                            </td>
                            <td>
                                <% if (row.quizAttempts > 0) { %>
                                    <div class="analytics-score-value"><%= row.quizScoreAvg %>%</div>
                                    <div class="analytics-score-meta"><%= row.quizAttempts %> attempts</div>
                                <% } else { %>
                                    <span class="text-muted analytics-no-attempts">No attempts</span>
                                <% } %>
                            </td>
                            <td>
                                <% 
                                   let badgeClass = 'status-Started';
                                   if (row.status === 'Completed') badgeClass = 'status-Completed';
                                   else if (row.status === 'In Progress') badgeClass = 'status-Progress';
                                %>
                                <span class="status-badge <%= badgeClass %>"><%= row.status %></span>
                            </td>
                            <td>
                                <a href="/admin/courses/<%= course._id %>/analytics/learners/<%= row.id %>" class="detail-btn">View Details <i class="fa-solid fa-chevron-right analytics-detail-icon" aria-hidden="true"></i></a>
                            </td>
                        </tr>
                    <% }); %>
                    <% if(analytics.studentRows.length === 0) { %>
                        <tr>
                            <td colspan="5" class="analytics-empty-cell">No enrolled learners found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script nonce="<%= cspNonce %>">
    // Inject backend data into window object for frontend parsing
    window.__ANALYTICS_DATA__ = <%- serializeJson({ charts: analytics.charts, reflections: analytics.reflections, courseId: String(course._id) }) %>;
</script>
<script src="/javascripts/analytics.js"></script>
