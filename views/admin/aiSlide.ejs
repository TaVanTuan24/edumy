<% layout('/layouts/boilerplate')%>
<link rel="stylesheet" href="/stylesheets/aiSlide.css">

<div class="ai-builder-page">
  <header class="ai-builder-header">
    <div>
      <p class="ai-builder-eyebrow">AI Slide Builder</p>
      <h2 class="mb-1">Draft first, then generate the final deck</h2>
      <p class="ai-builder-subtitle mb-0">Create semantic draft slides, preview them, edit content, then confirm into the slide editor.</p>
    </div>
    <a class="btn btn-outline-secondary" href="/admin">Back to Course Manager</a>
  </header>

  <input type="hidden" id="aiCourseId" value="<%= courseId || '' %>">

  <div class="ai-builder-shell">
    <aside class="ai-builder-sidebar">
      <section class="builder-panel">
        <div class="builder-panel-head">
          <span class="builder-step">Step 1</span>
          <h3>Generate Draft</h3>
        </div>

        <label class="form-label" for="aiSlidePrompt">Topic / Prompt</label>
        <textarea id="aiSlidePrompt" class="form-control ai-prompt-input" rows="7" maxlength="1000" placeholder="Example: Build a 5-slide introduction to Unity UI for beginner game development students."></textarea>

        <div class="builder-grid">
          <div>
            <label class="form-label" for="aiSlideCount">Slides</label>
            <select id="aiSlideCount" class="form-select">
              <option value="3">3 slides</option>
              <option value="4">4 slides</option>
              <option value="5" selected>5 slides</option>
              <option value="6">6 slides</option>
              <option value="7">7 slides</option>
              <option value="8">8 slides</option>
            </select>
          </div>
          <div>
            <label class="form-label" for="aiSlideStyle">Style</label>
            <select id="aiSlideStyle" class="form-select">
              <option value="modern" selected>Modern</option>
              <option value="professional">Professional</option>
              <option value="minimal">Minimal</option>
              <option value="dark">Dark</option>
            </select>
          </div>
          <div>
            <label class="form-label" for="aiSlideLanguage">Language</label>
            <select id="aiSlideLanguage" class="form-select">
              <option value="English" selected>English</option>
              <option value="Vietnamese">Vietnamese</option>
            </select>
          </div>
        </div>

        <div class="builder-actions">
          <button id="generateDraftBtn" class="btn btn-primary" type="button">
            <span id="aiSlideSpinner" class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
            Generate Draft
          </button>
          <button id="appendDraftBtn" class="btn btn-outline-secondary" type="button">Add Draft Slides</button>
        </div>

        <div id="aiSlideStatus" class="ai-status">Ready to generate a draft.</div>
      </section>

      <section class="builder-panel">
        <div class="builder-panel-head">
          <span class="builder-step">Step 2</span>
          <h3>Draft Controls</h3>
        </div>

        <div class="builder-actions stack">
          <button id="addDraftSlideBtn" class="btn btn-outline-primary" type="button">Add New Slide</button>
          <button id="confirmDraftBtn" class="btn btn-success" type="button">Confirm &amp; Generate Slides</button>
        </div>

        <ul class="builder-hints">
          <li>Edit title and bullets directly in the preview cards.</li>
          <li>Use drag and drop to reorder slides before confirming.</li>
          <li>Change the template per slide if you want a different layout.</li>
        </ul>
      </section>
    </aside>

    <main class="ai-builder-preview">
      <section class="builder-panel preview-panel">
        <div class="builder-panel-head">
          <span class="builder-step">Step 3</span>
          <h3>Draft Preview</h3>
          <div id="draftMeta" class="draft-meta">0 slides</div>
        </div>

        <div id="previewEmptyState" class="preview-empty">
          <h4>No draft slides yet</h4>
          <p>Generate a draft first. You will be able to edit every slide before the final deck is created.</p>
        </div>

        <div id="draftSlidesList" class="draft-slides-list" aria-live="polite"></div>
      </section>
    </main>
  </div>
</div>

<template id="draftSlideCardTemplate">
  <article class="draft-slide-card" draggable="true">
    <div class="draft-card-top">
      <div class="draft-card-meta">
        <span class="draft-slide-index">Slide 1</span>
        <span class="draft-slide-template-badge">bullet-list</span>
      </div>
      <div class="draft-card-actions">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-action="regenerate">Regenerate</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-action="improve">Improve</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-action="duplicate">Duplicate</button>
        <button type="button" class="btn btn-sm btn-outline-danger" data-action="delete">Delete</button>
      </div>
    </div>

    <div class="draft-field">
      <label>Template</label>
      <select class="form-select form-select-sm" data-field="template"></select>
    </div>

    <div class="draft-field">
      <label>Title</label>
      <input type="text" class="form-control" data-field="title" maxlength="180">
    </div>

    <div class="draft-field" data-role="subtitle-field">
      <label>Subtitle / Summary</label>
      <textarea class="form-control" rows="2" data-field="subtitle"></textarea>
    </div>

    <div class="draft-field" data-role="body-field">
      <label>Body / Callout</label>
      <textarea class="form-control" rows="3" data-field="body"></textarea>
    </div>

    <div class="draft-field" data-role="bullets-field">
      <div class="draft-field-header">
        <label>Bullets</label>
        <button type="button" class="btn btn-sm btn-outline-primary" data-action="add-bullet">Add Bullet</button>
      </div>
      <div class="draft-bullets-list" data-bullets-container></div>
    </div>

    <div class="draft-columns" data-role="columns-field">
      <div class="draft-column">
        <label>Left Column Heading</label>
        <input type="text" class="form-control" data-field="left-heading">
        <div class="draft-field-header mt-2">
          <label>Left Items</label>
          <button type="button" class="btn btn-sm btn-outline-primary" data-action="add-left-item">Add Item</button>
        </div>
        <div class="draft-bullets-list" data-left-items-container></div>
      </div>
      <div class="draft-column">
        <label>Right Column Heading</label>
        <input type="text" class="form-control" data-field="right-heading">
        <div class="draft-field-header mt-2">
          <label>Right Items</label>
          <button type="button" class="btn btn-sm btn-outline-primary" data-action="add-right-item">Add Item</button>
        </div>
        <div class="draft-bullets-list" data-right-items-container></div>
      </div>
    </div>
  </article>
</template>

<script src="/javascripts/admin/aiSlide.js" defer></script>
