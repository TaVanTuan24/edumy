<% layout('/layouts/boilerplate')%>
<link rel="stylesheet" href="/stylesheets/admin.css">

<div class="container-fluid py-4 px-lg-4">
    
    <!-- Header with Action -->
    <div class="admin-header-row">
        <div>
            <h1 class="mb-1 admin-page-title">Admin Dashboard</h1>
            <p class="mb-0 text-muted">Manage your platform courses, analytics, and content.</p>
        </div>
        <div>
            <a href="/courses/new" class="btn btn-primary d-flex align-items-center gap-2 px-4 shadow-sm">
                <i class="fa-solid fa-plus"></i> Create Course
            </a>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="admin-stats-row">
        <div class="admin-stat-card app-card">
            <h3>Total Courses</h3>
            <div class="stat-value"><%= stats.totalCourses %></div>
        </div>
        <div class="admin-stat-card app-card">
            <h3>Registered Users</h3>
            <div class="stat-value"><%= stats.totalUsers %></div>
        </div>
        <div class="admin-stat-card app-card">
            <h3>Total Enrollments</h3>
            <div class="stat-value"><%= stats.totalEnrollments %></div>
        </div>
    </div>

    <!-- Toolbar / Search / Filter (Optional UX enhancement placeholder) -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="admin-section-title">All Courses</h3>
        <div class="d-flex gap-2 flex-wrap">
            <% ['all', 'draft', 'published', 'archived'].forEach((filter) => { %>
                <a
                  href="/admin?<%= filter === 'all' ? '' : ('status=' + filter) %>"
                  class="btn btn-sm <%= statusFilter === filter ? 'btn-primary' : 'btn-outline-secondary' %>"
                >
                  <%= filter.charAt(0).toUpperCase() + filter.slice(1) %>
                </a>
            <% }) %>
        </div>
    </div>

    <!-- Course Grid -->
    <% if (courses && courses.length > 0) { %>
        <div class="row g-4">
            <% courses.forEach(course => { 
                // Calculate lessons sum
                let lessonCount = 0;
                if (course.sections && course.sections.length) {
                    course.sections.forEach(sec => {
                        if (sec.lessons) lessonCount += sec.lessons.length;
                    });
                }
                
                // Calculate average rating locally if reviews are populated or calculate from reviewEntries (we'll just use reviewEntries if available)
                let avgRating = 0;
                let reviewCount = 0;
                if (course.reviewEntries && course.reviewEntries.length > 0) {
                    reviewCount = course.reviewEntries.length;
                    const sum = course.reviewEntries.reduce((a, b) => a + (b.rating || 0), 0);
                    avgRating = (sum / reviewCount).toFixed(1);
                }
            %>
                <div class="col-sm-6 col-lg-4 col-xl-3 course-card-column">
                    <div class="card course-card app-card-elevated border-0">
                        <!-- Thumbnail -->
                        <img 
                          src="<%= course.images && course.images.length ? course.images[0].url : '/images/default-course.jpg' %>" 
                          alt="<%= course.title %>"
                          class="course-thumbnail"
                          onerror="this.onerror=null; this.src='/images/default-course.jpg';"
                        />
                        
                        <div class="card-body">
                            <!-- Badge -->
                            <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-2">
                                <span class="course-topic-badge app-badge app-badge-topic"><%= course.topic || 'General' %></span>
                                <span class="badge <%= course.statusBadge.status === 'published' ? 'bg-success' : course.statusBadge.status === 'draft' ? 'bg-warning text-dark' : 'bg-secondary' %>">
                                    <%= course.statusBadge.label %>
                                </span>
                            </div>
                            
                            <!-- Texts -->
                            <h4 class="course-title" title="<%= course.title %>"><%= course.title %></h4>
                            <div class="course-author"><i class="fa-solid fa-chalkboard-user"></i> <%= course.author && course.author.username ? course.author.username : 'Instructor' %></div>
                            
                            <!-- Stats Row -->
                            <div class="course-stats-row align-items-center">
                                <span title="Total Lessons"><i class="fa-solid fa-list-check"></i> <%= lessonCount %></span>
                                <span title="Checklist"><i class="fa-solid fa-circle-check"></i> <%= course.readiness.isPublishReady ? 'Ready' : 'Needs review' %></span>
                                <span title="Ratings" class="ms-auto admin-rating-summary">
                                    <% if (avgRating > 0) {
                                        const fullStars = Math.floor(avgRating);
                                        const halfStar = (avgRating - fullStars) >= 0.5 ? 1 : 0;
                                        const emptyStars = 5 - fullStars - halfStar;
                                        for(let i=0; i<fullStars; i++) { %><i class="fa-solid fa-star text-warning"></i><% }
                                        if (halfStar) { %><i class="fa-solid fa-star-half-stroke text-warning"></i><% }
                                        for(let i=0; i<emptyStars; i++) { %><i class="fa-regular fa-star text-warning"></i><% }
                                    %>
                                        <span class="ms-1 text-muted">(<%= reviewCount %>)</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary">New</span>
                                    <% } %>
                                </span>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="card-footer course-card-footer">
                            <a href="/admin/courses/<%= course._id %>/editor" class="btn btn-primary flex-grow-1 course-card-primary-btn">
                                <i class="fa-solid fa-pen-to-square"></i> Edit
                            </a>
                            <div class="dropdown course-card-actions" data-course-card-dropdown>
                                <button
                                    id="course-actions-toggle-<%= course._id %>"
                                    class="btn btn-outline-secondary course-card-menu-btn"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    data-bs-boundary="viewport"
                                    data-bs-offset="0,8"
                                    data-course-card-menu-toggle
                                    aria-expanded="false"
                                    aria-haspopup="menu"
                                    aria-controls="course-actions-menu-<%= course._id %>"
                                    aria-label="Open course actions"
                                >
                                    <i class="fa-solid fa-ellipsis"></i>
                                </button>
                                <div
                                    id="course-actions-menu-<%= course._id %>"
                                    class="dropdown-menu dropdown-menu-end course-card-menu"
                                    aria-labelledby="course-actions-toggle-<%= course._id %>"
                                >
                                    <a href="/admin/courses/<%= course._id %>/analytics" class="dropdown-item">
                                        <i class="fa-solid fa-chart-line"></i>
                                        <span>View analytics</span>
                                    </a>
                                    <% if (course.statusBadge.status !== 'published') { %>
                                      <form action="/admin/courses/<%= course._id %>/publish" method="POST">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="dropdown-item">
                                          <i class="fa-solid fa-upload"></i>
                                          <span>Publish course</span>
                                        </button>
                                      </form>
                                    <% } else { %>
                                      <form action="/admin/courses/<%= course._id %>/unpublish" method="POST">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="dropdown-item">
                                          <i class="fa-solid fa-eye-slash"></i>
                                          <span>Move to draft</span>
                                        </button>
                                      </form>
                                    <% } %>
                                    <% if (course.statusBadge.status !== 'archived') { %>
                                      <form action="/admin/courses/<%= course._id %>/archive" method="POST">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="dropdown-item">
                                          <i class="fa-solid fa-box-archive"></i>
                                          <span>Archive course</span>
                                        </button>
                                      </form>
                                    <% } %>
                                    <div class="dropdown-divider"></div>
                                    <form
                                        action="/courses/<%= course._id %>?_method=DELETE"
                                        method="POST"
                                        data-confirm-modal
                                        data-confirm-title="Delete Course"
                                        data-confirm-message="Delete '<%= course.title %>'? This will permanently remove the course and its content."
                                        data-confirm-warning="This action cannot be undone."
                                        data-confirm-text="Delete Course"
                                        data-confirming-text="Deleting..."
                                        data-confirm-variant="danger"
                                    >
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="fa-solid fa-trash"></i>
                                            <span>Delete course</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <!-- Empty State -->
        <div class="text-center py-5 admin-empty-state">
            <div class="admin-empty-state-icon">
                <i class="fa-solid fa-box-open"></i>
            </div>
            <h3 class="admin-empty-state-title">No courses found.</h3>
            <p class="text-muted">You haven't created any courses yet. Start building your platform!</p>
            <a href="/courses/new" class="btn btn-primary mt-3 px-4 py-2"><i class="fa-solid fa-plus me-2"></i> Create Your First Course</a>
        </div>
    <% } %>
</div>

<script src="/javascripts/admin/course-card-dropdowns.js" defer></script>
