<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Slide Editor - <%= course.title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="/stylesheets/slide-editor.css">
</head>

<body class="slide-editor-page" data-course-id="<%= course._id %>" data-section-index="<%= sectionIndex %>" data-lesson-index="<%= lessonIndex %>">
    <script id="slide-editor-data" type="application/json"><%- JSON.stringify(slideData || []) %></script>

    <header class="se-topbar">
        <div class="se-topbar-left">
            <div class="se-chip">Course Slide Studio</div>
            <input id="slideDeckTitle" class="se-title-input" type="text" value="<%= lessonTitle || (course.title + ' Deck') %>" aria-label="Slide title" maxlength="120">
        </div>
        <div class="se-topbar-actions">
            <button class="btn btn-outline-secondary" id="addSlideBtn" type="button">
                <i class="fa-solid fa-plus me-2"></i>New Slide
            </button>
            <button class="btn btn-outline-dark" id="previewBtn" type="button">
                <i class="fa-regular fa-eye me-2"></i>Preview
            </button>
            <button class="btn btn-primary" id="saveDeckBtn" type="button">
                <i class="fa-regular fa-floppy-disk me-2"></i>Save
            </button>
        </div>
    </header>

    <main class="se-layout">
        <aside class="se-panel se-left">
            <section class="se-card se-tools-card">
                <h2 class="se-panel-title">Tools</h2>
                <div class="d-grid gap-2">
                    <button class="btn btn-primary" id="addTextBtn" type="button">
                        <i class="fa-solid fa-font me-2"></i>Add Text
                    </button>
                    <button class="btn btn-outline-primary" id="addImageBtn" type="button">
                        <i class="fa-regular fa-image me-2"></i>Add Image
                    </button>
                </div>
                <input type="file" id="imageUploadInput" class="d-none" accept="image/*">
            </section>

            <section class="se-card">
                <h2 class="se-panel-title">Layers</h2>
                <ul class="se-list" id="layersList"></ul>
            </section>

            <section class="se-card">
                <div class="se-panel-title-row">
                    <h2 class="se-panel-title mb-0">Slides</h2>
                    <button class="btn btn-sm btn-light border" id="addSlideMiniBtn" type="button">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                </div>
                <ul class="se-list" id="slidesList"></ul>
            </section>
        </aside>

        <section class="se-canvas-stage" aria-label="Canvas area">
            <div class="se-canvas-shell">
                <div class="se-canvas-ratio">
                    <div id="slideCanvas" class="se-canvas" aria-label="Slide canvas"></div>
                </div>
            </div>
        </section>

        <aside class="se-panel se-right">
            <section class="se-card">
                <h2 class="se-panel-title">Properties</h2>
                <div id="emptyProperties" class="se-empty-state">
                    Select an element to edit style, size, and position.
                </div>

                <div id="propertiesPanel" class="d-none">
                    <div class="mb-3">
                        <label class="form-label se-label" for="propX">Position X</label>
                        <input id="propX" class="form-control form-control-sm" type="number" min="0" step="1">
                    </div>

                    <div class="mb-3">
                        <label class="form-label se-label" for="propY">Position Y</label>
                        <input id="propY" class="form-control form-control-sm" type="number" min="0" step="1">
                    </div>

                    <div id="textProps" class="d-none">
                        <div class="mb-3">
                            <label class="form-label se-label" for="propText">Text</label>
                            <textarea id="propText" class="form-control form-control-sm" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label se-label" for="propFontSize">Font Size</label>
                            <input id="propFontSize" class="form-control form-control-sm" type="number" min="10" max="120" step="1">
                        </div>
                        <div class="mb-3">
                            <label class="form-label se-label" for="propColor">Text Color</label>
                            <input id="propColor" class="form-control form-control-color" type="color" value="#1c1d1f">
                        </div>
                        <div class="mb-3 d-flex align-items-center gap-2">
                            <button id="propBold" class="btn btn-sm btn-outline-dark" type="button">Bold</button>
                            <div class="btn-group btn-group-sm" role="group" aria-label="Text alignment">
                                <button id="alignLeft" class="btn btn-outline-secondary" type="button">Left</button>
                                <button id="alignCenter" class="btn btn-outline-secondary" type="button">Center</button>
                                <button id="alignRight" class="btn btn-outline-secondary" type="button">Right</button>
                            </div>
                        </div>
                    </div>

                    <div id="imageProps" class="d-none">
                        <div class="mb-3">
                            <label class="form-label se-label" for="propWidth">Width</label>
                            <input id="propWidth" class="form-control form-control-sm" type="number" min="40" step="1">
                        </div>
                        <div class="mb-3">
                            <label class="form-label se-label" for="propHeight">Height</label>
                            <input id="propHeight" class="form-control form-control-sm" type="number" min="40" step="1">
                        </div>
                    </div>

                    <button id="deleteElementBtn" class="btn btn-sm btn-outline-danger w-100" type="button">
                        <i class="fa-regular fa-trash-can me-2"></i>Delete Element
                    </button>
                </div>
            </section>
        </aside>
    </main>

    <div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Slide Preview</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="se-preview-ratio">
                        <div id="previewCanvas" class="se-preview-canvas"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="/javascripts/slide-editor.js"></script>
</body>

</html>
