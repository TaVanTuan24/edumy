<% hideFooter = true; mainClass = 'app-content-full'; layout('/layouts/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/slide-editor.css">

<div class="slide-editor-page" data-course-id="<%= course._id %>" data-section-index="<%= sectionIndex %>" data-lesson-index="<%= lessonIndex %>">
    <script id="slide-editor-data" type="application/json"><%- serializeJson(slideData || []) %></script>
    <script id="slide-editor-pdf-data" type="application/json"><%- serializeJson(pdfData || null) %></script>

    <header class="se-topbar">
        <div class="se-topbar-left">
            <a href="/admin/courses/<%= course._id %>/editor" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left"></i>
                <span>Back to Course</span>
            </a>
            <div class="se-chip">Course Slide Studio</div>
            <input id="slideDeckTitle" class="se-title-input" type="text" value="<%= lessonTitle || (course.title + ' Deck') %>" aria-label="Slide title" maxlength="120">
        </div>
        <div class="se-topbar-actions">
            <div class="se-topbar-group se-topbar-group-secondary">
                <button class="btn btn-outline-danger" id="importPdfBtn" type="button">
                    <i class="fa-regular fa-file-pdf"></i>
                    <span>PDF</span>
                </button>
                <button class="btn btn-outline-secondary" id="addSlideBtn" type="button">
                    <i class="fa-solid fa-plus"></i>
                    <span>New Slide</span>
                </button>
                <button class="btn btn-outline-dark" id="previewBtn" type="button">
                    <i class="fa-regular fa-eye"></i>
                    <span>Preview</span>
                </button>
            </div>
            <div class="se-topbar-group se-topbar-group-primary">
                <button class="btn btn-success" id="saveToLibraryBtn" type="button">
                    <i class="fa-solid fa-bookmark"></i>
                    <span>Library</span>
                </button>
                <button class="btn btn-primary" id="saveDeckBtn" type="button">
                    <i class="fa-regular fa-floppy-disk"></i>
                    <span>Save</span>
                </button>
            </div>
        </div>
    </header>

    <main class="se-layout">
        <aside class="se-panel se-left">
            <section class="se-card se-tools-card">
                <h2 class="se-panel-title">Tools</h2>
                <div class="d-grid gap-2">
                    <button class="btn btn-primary" id="addTextBtn" type="button">
                        <i class="fa-solid fa-font me-2"></i>Add Text
                    </button>
                    <button class="btn btn-outline-primary" id="addImageBtn" type="button">
                        <i class="fa-regular fa-image me-2"></i>Add Image
                    </button>
                </div>
                <input type="file" id="imageUploadInput" class="d-none" accept="image/*">
            </section>

            <section class="se-card">
                <h2 class="se-panel-title">Layers</h2>
                <ul class="se-list" id="layersList"></ul>
            </section>

            <section class="se-card">
                <div class="se-panel-title-row">
                    <h2 class="se-panel-title mb-0">Slides</h2>
                    <button class="btn btn-sm btn-light border" id="addSlideMiniBtn" type="button">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                </div>
                <ul class="se-list" id="slidesList"></ul>
            </section>
        </aside>

        <section class="se-canvas-stage" aria-label="Canvas area">
            <div class="se-canvas-shell">
                <div class="se-canvas-ratio">
                    <div id="slideCanvas" class="se-canvas" aria-label="Slide canvas"></div>
                </div>
            </div>
        </section>

        <aside class="se-panel se-right">
            <section class="se-card">
                <h2 class="se-panel-title">Slide Settings</h2>
                <div class="se-pdf-helper mb-3">
                    Upload a PDF to use it as a lesson document. Learners will view it directly in the course player.
                </div>
                <div class="se-pdf-card" id="pdfMetaCard">
                    <div class="se-pdf-card-header">
                        <div>
                            <div class="se-pdf-label">Lesson document</div>
                            <div class="se-pdf-name" id="pdfMetaName">No PDF uploaded</div>
                        </div>
                        <span class="se-pdf-badge" id="pdfMetaBadge">No PDF</span>
                    </div>
                    <div class="se-pdf-meta" id="pdfMetaDetails">Upload a PDF to attach a lesson document.</div>
                    <div class="se-pdf-actions">
                        <button class="btn btn-sm btn-outline-danger" id="replacePdfBtn" type="button">
                            <i class="fa-solid fa-upload me-2"></i>Upload / Replace
                        </button>
                        <a class="btn btn-sm btn-outline-secondary d-none" id="viewPdfBtn" href="#" target="_blank" rel="noopener noreferrer">
                            <i class="fa-regular fa-eye me-2"></i>View PDF
                        </a>
                        <button class="btn btn-sm btn-outline-secondary d-none" id="removePdfBtn" type="button">
                            <i class="fa-regular fa-trash-can me-2"></i>Remove PDF
                        </button>
                    </div>
                    <div class="se-pdf-status" id="pdfUploadStatus" aria-live="polite"></div>
                </div>
                <div class="se-content-mode-note" id="contentModeNote" aria-live="polite"></div>
                <div class="mb-2">
                    <label class="form-label se-label" for="slideThemeSelect">Theme</label>
                    <select id="slideThemeSelect" class="form-select form-select-sm">
                        <option value="light">Light</option>
                        <option value="dark">Dark</option>
                        <option value="purple">Purple</option>
                        <option value="blue">Blue</option>
                    </select>
                </div>
            </section>
            <section class="se-card">
                <h2 class="se-panel-title">Properties</h2>
                <div id="emptyProperties" class="se-empty-state">
                    Select an element to edit style, size, and position.
                </div>

                <div id="propertiesPanel" class="d-none">
                    <div class="mb-3">
                        <label class="form-label se-label" for="propX">Position X</label>
                        <input id="propX" class="form-control form-control-sm" type="number" min="0" step="1">
                    </div>

                    <div class="mb-3">
                        <label class="form-label se-label" for="propY">Position Y</label>
                        <input id="propY" class="form-control form-control-sm" type="number" min="0" step="1">
                    </div>

                    <div id="textProps" class="d-none">
                        <div class="mb-3">
                            <label class="form-label se-label" for="propText">Text</label>
                            <textarea id="propText" class="form-control form-control-sm" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label se-label" for="propFontSize">Font Size</label>
                            <input id="propFontSize" class="form-control form-control-sm" type="number" min="10" max="40" step="1">
                        </div>
                        <div class="mb-3">
                            <label class="form-label se-label" for="propColor">Text Color</label>
                            <input id="propColor" class="form-control form-control-color" type="color" value="#1c1d1f">
                        </div>
                        <div class="mb-3 d-flex align-items-center gap-2">
                            <button id="propBold" class="btn btn-sm btn-outline-dark" type="button">Bold</button>
                            <div class="btn-group btn-group-sm" role="group" aria-label="Text alignment">
                                <button id="alignLeft" class="btn btn-outline-secondary" type="button">Left</button>
                                <button id="alignCenter" class="btn btn-outline-secondary" type="button">Center</button>
                                <button id="alignRight" class="btn btn-outline-secondary" type="button">Right</button>
                            </div>
                        </div>
                    </div>

                    <div id="imageProps" class="d-none">
                        <div class="mb-3">
                            <label class="form-label se-label" for="propImageSrc">Image URL</label>
                            <input id="propImageSrc" class="form-control form-control-sm" type="url" placeholder="https://example.com/image.jpg">
                        </div>
                        <div class="mb-3">
                            <button id="propImageUploadBtn" class="btn btn-sm btn-outline-primary w-100" type="button">
                                <i class="fa-solid fa-upload me-2"></i>Upload New Image
                            </button>
                            <input type="file" id="propImageUploadInput" class="d-none" accept="image/*">
                        </div>
                        <div class="mb-3 se-image-preview-wrap">
                            <div class="se-label">Preview</div>
                            <img id="propImagePreview" class="se-image-preview" alt="Image preview">
                            <div id="propImagePreviewEmpty" class="se-image-preview-empty">No image selected</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label se-label" for="propWidth">Width</label>
                            <input id="propWidth" class="form-control form-control-sm" type="number" min="40" step="1">
                        </div>
                        <div class="mb-3">
                            <label class="form-label se-label" for="propHeight">Height</label>
                            <input id="propHeight" class="form-control form-control-sm" type="number" min="40" step="1">
                        </div>
                    </div>

                    <button id="deleteElementBtn" class="btn btn-sm btn-outline-danger w-100" type="button">
                        <i class="fa-regular fa-trash-can me-2"></i>Delete Element
                    </button>
                </div>
            </section>
        </aside>
    </main>

    <input type="file" id="pdfUploadInput" class="d-none" accept="application/pdf,.pdf">

    <div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content app-modal-shell">
                <div class="modal-header app-modal-head">
                    <h5 class="modal-title">Slide Preview</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body app-modal-body">
                    <div class="se-preview-ratio">
                        <div id="previewCanvas" class="se-preview-canvas"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/javascripts/slide-editor.js"></script>
