<% layout('/layouts/boilerplate')%>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Course Editor - <%= course.title %></title>
    
    <!-- Bootstrap 5.3.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Font Awesome 6.4.0 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <!-- Custom Editor CSS -->
    <link rel="stylesheet" href="/stylesheets/editor.css">
</head>
<body data-course-id="<%= course._id %>">
    <% const sectionCount = Array.isArray(course.sections) ? course.sections.length : 0; %>
    <% const lessonCount = Array.isArray(course.sections) ? course.sections.reduce((total, section) => total + ((section.lessons || []).length), 0) : 0; %>
    <!-- Course Data (hidden, parsed by JavaScript) -->
    <script id="course-data" type="application/json">
        <%- serializeJson(course.sections || []) %>
    </script>

    <!-- Top Bar -->
    <header class="top-bar">
        <div class="top-bar-left">
            <p class="top-bar-label mb-0">Course Management</p>
            <h1 class="top-bar-title mb-0"><%= course.title %></h1>
            <div class="top-bar-meta">
                <span class="top-bar-meta-pill"><i class="fas fa-layer-group"></i><%= sectionCount %> section<%= sectionCount === 1 ? '' : 's' %></span>
                <span class="top-bar-meta-pill"><i class="fas fa-list-check"></i><%= lessonCount %> item<%= lessonCount === 1 ? '' : 's' %></span>
                <span class="top-bar-meta-pill"><i class="fas fa-flag"></i><%= statusBadge.label %></span>
                <span class="top-bar-meta-pill"><i class="fas fa-shield-halved"></i>Admin editor</span>
            </div>
            <div class="small text-muted">
                Last edited: <%= course.lastEditedAt ? new Date(course.lastEditedAt).toLocaleString() : 'Not available' %>
                <% if (course.publishedAt) { %>
                    • Published: <%= new Date(course.publishedAt).toLocaleString() %>
                <% } %>
            </div>
        </div>
        <div class="top-bar-actions">
            <div class="top-bar-action-group">
                <a href="/courses/<%= course._id %>" class="btn btn-outline-secondary editor-action-btn" target="_blank" rel="noopener noreferrer">
                    <i class="fas fa-eye me-2"></i>Preview
                </a>
                <button class="btn btn-outline-primary editor-action-btn" type="button" data-bs-toggle="modal" data-bs-target="#youtubeImportModal">
                    <i class="fa-brands fa-youtube me-2"></i>Import Playlist
                </button>
                <a href="/admin/ai/quiz" class="btn btn-warning editor-action-btn editor-action-btn-warning">
                    <i class="fas fa-robot me-2"></i>AI quiz
                </a>
                <a href="/admin/ai/slide?courseId=<%= course._id %>" class="btn btn-warning editor-action-btn editor-action-btn-warning">
                    <i class="fas fa-wand-magic-sparkles me-2"></i>AI slide
                </a>
                <% if (statusBadge.status !== 'published') { %>
                    <form action="/admin/courses/<%= course._id %>/publish" method="POST" class="m-0">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-success editor-action-btn">
                            <i class="fas fa-upload me-2"></i><%= readiness.isPublishReady ? 'Publish' : 'Publish Anyway' %>
                        </button>
                    </form>
                <% } else { %>
                    <form action="/admin/courses/<%= course._id %>/unpublish" method="POST" class="m-0">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-outline-warning editor-action-btn">
                            <i class="fas fa-eye-slash me-2"></i>Move To Draft
                        </button>
                    </form>
                <% } %>
                <% if (statusBadge.status !== 'archived') { %>
                    <form action="/admin/courses/<%= course._id %>/archive" method="POST" class="m-0">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-outline-dark editor-action-btn">
                            <i class="fas fa-box-archive me-2"></i>Archive
                        </button>
                    </form>
                <% } %>
            </div>
            <div class="top-bar-action-group top-bar-action-group-primary">
                <button class="btn btn-primary editor-action-btn editor-action-btn-primary" id="saveCourseBtn">
                    <i class="fas fa-save me-2"></i>Save Changes
                </button>
                <button class="btn btn-outline-danger editor-action-btn editor-action-btn-danger" type="button" data-bs-toggle="modal" data-bs-target="#deleteCourseModal">
                    <i class="fas fa-trash-can me-2"></i>Delete Course
                </button>
            </div>
        </div>
    </header>

    <!-- Main Layout -->
    <div class="editor-layout">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <h5 class="sidebar-title mb-0"><i class="fas fa-layer-group me-2"></i>Curriculum</h5>
                    <button class="btn btn-sm btn-outline-primary add-section-btn editor-mini-btn" type="button">
                        <i class="fas fa-plus me-1"></i>Add section
                    </button>
                </div>
                <p class="sidebar-subtitle mb-1">Organize your sections and lessons.</p>
                <div id="reorderStatus" class="reorder-status" aria-live="polite"></div>
                <div class="mt-3 small">
                    <strong>Publish checklist</strong>
                    <div class="d-grid gap-1 mt-2">
                        <% readiness.items.forEach((item) => { %>
                            <div class="d-flex justify-content-between align-items-center">
                                <span><%= item.label %></span>
                                <span class="badge <%= item.ok ? 'bg-success' : (item.critical ? 'bg-danger' : 'bg-secondary') %>">
                                    <%= item.ok ? 'OK' : (item.critical ? 'Required' : 'Optional') %>
                                </span>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>

            <div class="sidebar-content" id="sectionsContainer">
                <% if (course.sections && course.sections.length > 0) { %>
                    <% course.sections.forEach((section, sIndex) => { %>
                        <div class="section-card" data-section-id="<%= section._id %>">
                            <div class="section-header" data-section-index="<%= sIndex %>">
                                <i class="fas fa-chevron-right section-icon" id="icon-<%= sIndex %>"></i>
                                <span class="section-title" id="title-<%= section._id %>" data-section-index="<%= sIndex %>" title="Click to rename">
                                    <%= section.title || 'Untitled Section' %>
                                </span>
                                <div class="actions">
                                    <button class="edit-section-btn editor-inline-action" type="button" data-section-id="<%= section._id %>" title="Rename section">
                                        <i class="fas fa-pen"></i>
                                        <span>Rename</span>
                                    </button>
                                    <button class="delete-section-btn editor-inline-action editor-inline-action-danger" type="button" data-section-id="<%= section._id %>" title="Delete section">
                                        <i class="fas fa-trash"></i>
                                        <span>Delete</span>
                                    </button>
                                </div>
                            </div>
                            <div class="lesson-list section-content" 
                                 id="section-content-<%= sIndex %>" 
                                 data-section-id="<%= section._id %>"
                                 data-section-index="<%= sIndex %>">
                                <% if (section.lessons && section.lessons.length > 0) { %>
                                    <% section.lessons.forEach((video, vIndex) => { %>
                                        <div class="lesson-item" 
                                             data-item-id="<%= video._id %>" 
                                             data-section-id="<%= section._id %>"
                                             data-section-index="<%= sIndex %>"
                                             data-lesson-index="<%= vIndex %>"
                                             data-order="<%= typeof video.order === 'number' ? video.order : vIndex %>"
                                             data-type="<%= video.type %>"
                                             data-name="<%= video.title || '' %>"
                                             data-url="<%= video.preview || video.videoUrl || video.refId || '' %>"
                                             data-ref-id="<%= video.refId || '' %>">
                                            <span class="drag-handle"><i class="fa-solid fa-grip-vertical"></i></span>
                                            <div class="item-icon <%= video.type %>">
                                                <i class="fas <%= (video.type === 'video' || video.type === 'lecture') ? 'fa-play' : video.type === 'slide' ? 'fa-file-alt' : video.type === 'quiz' ? 'fa-question' : 'fa-play' %>"></i>
                                            </div>
                                            <div class="item-info">
                                                <div class="item-title">
                                                    <%= video.title || 'Untitled' %>
                                                </div>
                                                <div class="item-meta">
                                                        <%= (video.type === 'video' || video.type === 'lecture') ? 'Lecture' : video.type === 'quiz' ? 'Quiz' : video.type === 'slide' ? 'Slide' : 'Lecture' %>
                                                </div>
                                            </div>
                                            <div class="item-actions">
                                                <button class="edit-btn editor-inline-action" type="button" data-id="<%= video._id %>" data-type="<%= video.type === 'lecture' ? 'video' : video.type %>" data-section-index="<%= sIndex %>" data-lesson-index="<%= vIndex %>" title="Edit lesson">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                    <span>Edit</span>
                                                </button>
                                                <button class="delete-item-btn editor-inline-action editor-inline-action-danger" type="button" title="Delete lesson">
                                                    <i class="fa-solid fa-trash"></i>
                                                    <span>Delete</span>
                                                </button>
                                            </div>
                                        </div>
                                    <% }); %>
                                <% } %>
                            </div>
                            <div class="add-buttons">
                                <button class="add-item-btn add-video-btn" type="button" data-section-index="<%= sIndex %>" data-item-type="video">
                                    <i class="fas fa-play"></i><span>Lecture</span>
                                </button>
                                <button class="add-item-btn add-slide-btn" type="button" data-section-index="<%= sIndex %>" data-item-type="slide">
                                    <i class="fas fa-file-alt"></i><span>Slide</span>
                                </button>
                                <button class="add-item-btn add-quiz-btn" type="button" data-section-index="<%= sIndex %>" data-item-type="quiz">
                                    <i class="fas fa-question"></i><span>Quiz</span>
                                </button>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="text-center py-4 text-muted">
                        <i class="fas fa-folder-open fa-2x mb-3 d-block"></i>
                        <p>No sections yet</p>
                        <button class="btn btn-primary add-section-empty-btn">
                            <i class="fas fa-plus me-1"></i> Add Section
                        </button>
                    </div>
                <% } %>
            </div>
        </aside>

        <!-- Editor Panel -->
        <main class="editor-panel">
            <div class="editor-placeholder" id="editorPlaceholder">
                <i class="fas fa-mouse-pointer"></i>
                <h4>Select content to edit</h4>
                <p>Pick a lesson, quiz, or slide from the left to start editing.</p>
            </div>
            <div id="editorContent" class="editor-content d-none">
                <!-- Dynamic content will be loaded here -->
            </div>
        </main>
    </div>

    <!-- Library Toggle Button -->
    <button class="library-add-btn" id="libraryToggleBtn" title="Content Library">
        <i class="fas fa-plus"></i>
    </button>

    <!-- Content Library Popup -->
    <div class="library-popup" id="libraryPopup">
        <div class="library-popup-header">
            <h6><i class="fas fa-library me-2"></i>Content Library</h6>
            <button class="close-btn" id="libraryCloseBtn">&times;</button>
        </div>
        <div class="library-tabs">
            <button class="active" data-tab-type="video">Videos</button>
            <button data-tab-type="slide">Slides</button>
            <button data-tab-type="quiz">Quizzes</button>
        </div>
        <div class="library-content" id="libraryContent">
            <div class="library-empty">
                <i class="fas fa-spinner fa-spin"></i>
                <p>Loading...</p>
            </div>
        </div>
    </div>

    <!-- Add Item Modal -->
    <div class="modal fade add-item-modal" id="addItemModal" tabindex="-1" aria-labelledby="addItemModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-2">
                    <div>
                        <h5 class="modal-title" id="addItemModalLabel">Add New Item</h5>
                        <p class="modal-subtitle mb-0" id="addItemModalSubtitle">Create content for this section.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-0">
                    <form id="addItemForm" novalidate>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div id="addItemError" class="alert alert-danger d-none mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label for="addItemName" class="form-label">Title</label>
                            <input type="text" class="form-control" id="addItemName" placeholder="Enter title" maxlength="150" required>
                            <div class="invalid-feedback" id="addItemNameFeedback">Please enter a title.</div>
                        </div>

                        <div class="mb-3" id="addItemUrlGroup">
                            <label for="addItemUrl" class="form-label">Video URL <span class="text-muted">(optional)</span></label>
                            <input type="url" class="form-control" id="addItemUrl" placeholder="https://example.com/video">
                            <div class="invalid-feedback" id="addItemUrlFeedback">Please enter a valid URL (including http:// or https://).</div>
                        </div>

                        <div class="mb-1">
                            <label for="addItemDescription" class="form-label">Description <span class="text-muted">(optional)</span></label>
                            <textarea class="form-control" id="addItemDescription" rows="3" placeholder="Short description for your team"></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-0 pt-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" form="addItemForm" class="btn btn-primary" id="addItemSubmitBtn" disabled>
                        <span class="spinner-border spinner-border-sm me-2 d-none" id="addItemSubmitSpinner" role="status" aria-hidden="true"></span>
                        <span id="addItemSubmitLabel">Create</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="youtubeImportModal" tabindex="-1" aria-labelledby="youtubeImportModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="youtubeImportModalLabel">Import YouTube Playlist</h5>
                        <p class="modal-subtitle mb-0 text-muted">Fetch playlist videos, organize them into sections, review the structure, then append them to this course.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="youtube-import-card" data-youtube-import-root data-import-mode="apply" data-course-id="<%= course._id %>">
                        <label class="form-label" for="editorYoutubePlaylistUrl">YouTube Playlist URL</label>
                        <div class="input-group">
                            <input class="form-control" id="editorYoutubePlaylistUrl" type="url" placeholder="https://www.youtube.com/playlist?list=..." data-youtube-playlist-url>
                            <button class="btn btn-outline-primary" type="button" data-youtube-preview-btn>Import Playlist</button>
                        </div>
                        <div class="form-text">Preview first. Imported sections will be appended to the current course.</div>
                        <div class="youtube-import-feedback mt-3 small text-muted" data-youtube-import-status>Paste a playlist URL to begin.</div>
                        <div class="youtube-import-preview mt-3 d-none" data-youtube-preview></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade delete-course-modal" id="deleteCourseModal" tabindex="-1" aria-labelledby="deleteCourseModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-2">
                    <div>
                        <p class="delete-course-modal-kicker mb-1">Danger zone</p>
                        <h5 class="modal-title" id="deleteCourseModalLabel">Delete this course?</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-0">
                    <p class="mb-2">This will permanently delete <strong><%= course.title %></strong>, including its sections, lessons, and related editor content.</p>
                    <p class="text-muted mb-0">This action cannot be undone.</p>
                </div>
                <div class="modal-footer border-0 pt-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form action="/courses/<%= course._id %>?_method=DELETE" method="POST" class="m-0">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash-can me-2"></i>Delete Course
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Section Modal -->
    <div class="modal fade" id="addSectionModal" tabindex="-1" aria-labelledby="addSectionModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-2">
                    <div>
                        <h5 class="modal-title" id="addSectionModalLabel">Add New Section</h5>
                        <p class="modal-subtitle mb-0 text-muted">Create a new module for your course curriculum.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-0">
                    <form id="addSectionForm" novalidate>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="mb-3">
                            <label for="addSectionTitle" class="form-label fw-bold">Section Title</label>
                            <input type="text" class="form-control" id="addSectionTitle" placeholder="e.g. Chapter 1: Introduction" maxlength="150" required>
                            <div class="invalid-feedback">Please enter a valid title.</div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-0 pt-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="addSectionSubmitBtn">Create Section</button>
                </div>
            </div>
        </div>
    </div>

    <!-- SortableJS -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <!-- Custom Editor JavaScript -->
    <script src="/javascripts/editor.js"></script>
    <script src="/javascripts/youtube-course-import.js"></script>
</body>
