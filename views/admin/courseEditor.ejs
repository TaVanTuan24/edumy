<% layout('/layouts/boilerplate')%>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Course Editor - <%= course.title %></title>
    
    <!-- Bootstrap 5.3.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Font Awesome 6.4.0 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <!-- SortableJS -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js" integrity="sha384-7+1LstXK3qJ5Y5m5PdmQ0KjXa0d1dVqujRRubGzmI1T2wFxy1L3Pl2jL5J5F2F" crossorigin="anonymous"></script>
    
    <!-- Custom Editor CSS -->
    <link rel="stylesheet" href="/stylesheets/editor.css">
</head>
<body data-course-id="<%= course._id %>">
    <!-- Course Data (hidden, parsed by JavaScript) -->
    <script id="course-data" type="application/json">
        <%= JSON.stringify(course.driveStructure || []) %>
    </script>

    <!-- Top Bar -->
    <div class="top-bar">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/admin">Courses</a></li>
                <li class="breadcrumb-item active"><%= course.title %></li>
            </ol>
        </nav>
        <button class="btn btn-primary" id="saveCourseBtn">
            <i class="fas fa-save me-2"></i>Save
        </button>
    </div>

    <!-- Main Layout -->
    <div class="editor-layout">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5><i class="fas fa-book me-2"></i>Course Content</h5>
                    <button class="btn btn-sm btn-outline-primary add-section-btn">
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
            </div>

            <div class="sidebar-content" id="sectionsContainer">
                <% if (course.driveStructure && course.driveStructure.length > 0) { %>
                    <% course.driveStructure.forEach((section, sIndex) => { %>
                        <div class="section-card" data-section-id="<%= section._id %>">
                            <div class="section-header" data-section-index="<%= sIndex %>">
                                <i class="fas fa-chevron-right section-icon" id="icon-<%= sIndex %>"></i>
                                <span class="section-title" id="title-<%= section._id %>">
                                    <%= section.section || 'Untitled Section' %>
                                </span>
                                <div class="actions">
                                    <button class="edit-section-btn" data-section-id="<%= section._id %>" title="Edit section">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="delete-section-btn" data-section-id="<%= section._id %>" title="Delete section">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="lesson-list section-content" 
                                 id="section-content-<%= sIndex %>" 
                                 data-section-id="<%= section._id %>"
                                 data-section-index="<%= sIndex %>">
                                <% if (section.videos && section.videos.length > 0) { %>
                                    <% section.videos.forEach((video, vIndex) => { %>
                                        <div class="lesson-item" 
                                             data-item-id="<%= video._id %>" 
                                             data-section-id="<%= section._id %>"
                                             data-section-index="<%= sIndex %>"
                                             data-lesson-index="<%= vIndex %>"
                                             data-type="<%= video.type %>"
                                             data-name="<%= video.name || '' %>"
                                             data-url="<%= video.preview || video.refId || '' %>"
                                             data-ref-id="<%= video.refId || '' %>">
                                            <span class="drag-handle"><i class="fas fa-grip-vertical"></i></span>
                                            <div class="item-icon <%= video.type %>">
                                                <i class="fas <%= video.type === 'video' ? 'fa-play' : video.type === 'slide' ? 'fa-file-alt' : 'fa-question' %>"></i>
                                            </div>
                                            <div class="item-info">
                                                <div class="item-title">
                                                    <%= video.name || 'Untitled' %>
                                                </div>
                                                <div class="item-meta">
                                                    <%= video.type === 'video' ? 'Video' : video.type === 'slide' ? 'Slide' : 'Quiz' %>
                                                </div>
                                            </div>
                                            <div class="item-actions">
                                                <button class="edit-btn" 
                                                    data-id="<%= video.refId || '' %>" 
                                                    data-type="<%= video.type %>"
                                                    title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    <% }); %>
                                <% } %>
                            </div>
                            <div class="add-buttons">
                                <button class="add-item-btn" data-section-index="<%= sIndex %>" data-item-type="video">
                                    <i class="fas fa-play"></i> Video
                                </button>
                                <button class="add-item-btn" data-section-index="<%= sIndex %>" data-item-type="slide">
                                    <i class="fas fa-file-alt"></i> Slide
                                </button>
                                <button class="add-item-btn" data-section-index="<%= sIndex %>" data-item-type="quiz">
                                    <i class="fas fa-question"></i> Quiz
                                </button>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="text-center py-4 text-muted">
                        <i class="fas fa-folder-open fa-2x mb-3 d-block"></i>
                        <p>No sections yet</p>
                        <button class="btn btn-primary add-section-empty-btn">
                            <i class="fas fa-plus me-1"></i> Add Section
                        </button>
                    </div>
                <% } %>
            </div>
        </aside>

        <!-- Editor Panel -->
        <main class="editor-panel">
            <div class="editor-placeholder" id="editorPlaceholder">
                <i class="fas fa-mouse-pointer"></i>
                <h4>Select content to edit</h4>
                <p>Choose an item from the sidebar</p>
            </div>
            <div id="editorContent" style="display: none;">
                <!-- Dynamic content will be loaded here -->
            </div>
        </main>
    </div>

    <!-- Library Toggle Button -->
    <button class="library-add-btn" id="libraryToggleBtn" title="Content Library">
        <i class="fas fa-plus"></i>
    </button>

    <!-- Content Library Popup -->
    <div class="library-popup" id="libraryPopup">
        <div class="library-popup-header">
            <h6><i class="fas fa-library me-2"></i>Content Library</h6>
            <button class="close-btn" id="libraryCloseBtn">&times;</button>
        </div>
        <div class="library-tabs">
            <button class="active" data-tab-type="video">Videos</button>
            <button data-tab-type="slide">Slides</button>
            <button data-tab-type="quiz">Quizzes</button>
        </div>
        <div class="library-content" id="libraryContent">
            <div class="library-empty">
                <i class="fas fa-spinner fa-spin"></i>
                <p>Loading...</p>
            </div>
        </div>
    </div>

    <!-- Custom Editor JavaScript -->
    <script src="/javascripts/editor.js"></script>
</body>
