<% layout('/layouts/boilerplate')%>
<link rel="stylesheet" href="/stylesheets/aiQuiz.css">

<div class="ai-quiz-page app-page-shell">
  <header class="ai-quiz-header">
    <div>
      <h2 class="mb-1">AI Quiz Generator</h2>
      <p class="text-muted mb-0">Generate, edit, and save quizzes to your Content Library.</p>
    </div>
    <a class="btn btn-outline-secondary" href="/admin">Back to Course Manager</a>
  </header>

  <section class="ai-quiz-controls app-card-elevated">
    <div class="control-row">
      <div class="control-block">
        <label for="quizTitle">Quiz title</label>
        <input id="quizTitle" class="form-control" placeholder="AI Generated Quiz" maxlength="120">
      </div>
      <div class="control-block">
        <label for="aiPrompt">Topic / Prompt</label>
        <textarea id="aiPrompt" class="form-control" rows="3" placeholder="Nhập chủ đề..." maxlength="1000"></textarea>
      </div>
    </div>
    <div class="control-row">
      <div class="control-inline">
        <label for="aiDifficulty">Difficulty</label>
        <select id="aiDifficulty" class="form-select">
          <option value="easy">Easy</option>
          <option value="medium" selected>Medium</option>
          <option value="hard">Hard</option>
        </select>
      </div>
      <div class="control-inline">
        <label for="aiCount">Questions</label>
        <input id="aiCount" class="form-control" type="number" min="1" max="10" value="5">
      </div>
      <div class="control-actions">
        <button id="generateQuizBtn" class="btn btn-primary">Generate</button>
        <button id="generateMoreBtn" class="btn btn-outline-primary">Generate more</button>
        <button id="addQuestionBtn" class="btn btn-outline-secondary">Add question</button>
      </div>
    </div>
    <div id="aiStatus" class="ai-status">Ready.</div>
  </section>

  <section class="ai-quiz-editor app-card-elevated">
    <div class="editor-header">
      <h4 class="mb-0">Quiz Editor</h4>
      <button id="saveQuizBtn" class="btn btn-success">Save to Library</button>
    </div>
    <div id="quizEditor" class="quiz-editor"></div>
  </section>
</div>

<script src="/javascripts/admin/aiQuiz.js" defer></script>
