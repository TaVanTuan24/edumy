<% layout('/layouts/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/video-settings.css">

<div class="video-settings-page" data-course-id="<%= course._id %>" data-section-index="<%= sectionIndex %>" data-lesson-index="<%= lessonIndex %>">
  <header class="video-settings-header">
    <div>
      <p class="video-settings-kicker mb-1">Advanced Video Settings</p>
      <h1 class="video-settings-title mb-1"><%= stripFileExtension(lesson.title) || 'Video Lesson' %></h1>
      <p class="text-muted mb-0"><%= course.title %></p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <a class="btn btn-outline-secondary" href="/admin/courses/<%= course._id %>/editor">
        <i class="fa-solid fa-arrow-left me-1"></i>Back To Editor
      </a>
      <a class="btn btn-outline-primary" href="/courses/<%= course._id %>" target="_blank" rel="noopener noreferrer">
        <i class="fa-solid fa-eye me-1"></i>Preview Course
      </a>
    </div>
  </header>

  <div class="video-settings-layout">
    <section class="video-pane">
      <div id="videoProviderHint" class="video-provider-hint mb-2"></div>
      <div class="video-frame-wrap ratio ratio-16x9">
        <iframe
          id="videoSettingsIframe"
          src=""
          allow="autoplay; fullscreen; encrypted-media; picture-in-picture"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"></iframe>
        <div id="videoPreviewOverlay" class="video-preview-overlay">
          <button id="videoSettingsMarker" class="video-settings-marker" type="button" aria-label="Drag quiz position"><i class="fa-solid fa-circle-question" aria-hidden="true"></i></button>
          <button id="videoPreviewHotspot" class="video-preview-hotspot video-preview-hotspot-hidden" type="button" aria-label="Open quiz preview"><i class="fa-solid fa-bolt" aria-hidden="true"></i></button>
          <div id="videoPreviewQuizPopup" class="video-preview-quiz-popup video-preview-quiz-popup-hidden" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <aside class="quiz-sidebar">
      <div class="quiz-sidebar-head">
        <div class="quiz-sidebar-head-row">
          <div>
            <h5 class="mb-1">Timed Quizzes</h5>
            <p class="text-muted small mb-0">Manage all checkpoint quizzes for this video.</p>
          </div>
          <button id="timedQuizFab" class="timed-quiz-fab" type="button" title="Add timed quiz">
            <i class="fa-solid fa-plus"></i>
            <span>Add Quiz</span>
          </button>
        </div>
        <div class="ai-quiz-tools mt-3">
          <button id="aiAutoQuizBtn" class="btn ai-auto-quiz-btn w-100" type="button">
            AI real-time quiz generation
          </button>
          <div class="mt-2">
            <label for="aiAutoQuizCount" class="form-label small mb-1">Số câu hỏi</label>
            <input id="aiAutoQuizCount" class="form-control form-control-sm" type="number" min="1" max="15" value="5">
          </div>
          <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" id="aiAutoQuizStrictMode">
            <label class="form-check-label small" for="aiAutoQuizStrictMode">Strict mode</label>
          </div>
          <div id="aiAutoQuizStatus" class="small text-muted mt-2"></div>
        </div>
      </div>
      <div id="timedQuizPanel" class="timed-quiz-panel" aria-hidden="true">
        <div class="timed-quiz-panel-head">
          <h6 class="mb-0" id="timedQuizPanelTitle">Add Timed Quiz</h6>
          <button id="timedQuizCloseBtn" class="btn btn-sm btn-light" type="button">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <div class="timed-quiz-panel-body">
          <input type="hidden" id="timedQuizEditId" value="">

          <div class="mb-2">
            <label class="form-label">Timestamp</label>
            <input id="timedQuizTimestamp" class="form-control form-control-sm" placeholder="03:50 or 230">
          </div>

          <div class="mb-2">
            <label class="form-label">Question</label>
            <textarea id="timedQuizQuestion" class="form-control form-control-sm" rows="2" placeholder="Type question"></textarea>
          </div>

          <div class="row g-2">
            <% for (let i = 0; i < 4; i++) { %>
              <div class="col-12">
                <label class="form-label d-flex align-items-center justify-content-between mb-1">
                  <span>Option <%= i + 1 %></span>
                  <span class="small text-muted d-flex align-items-center gap-1">
                    <input type="checkbox" class="timedQuizCorrectCheck" data-correct-index="<%= i %>">
                    Correct
                  </span>
                </label>
                <input class="form-control form-control-sm timedQuizOptionInput" data-option-index="<%= i %>" placeholder="Option <%= i + 1 %>">
              </div>
            <% } %>
          </div>

          <div class="mb-2 mt-2">
            <label class="form-label">Explanation (optional)</label>
            <textarea id="timedQuizExplanation" class="form-control form-control-sm" rows="2" placeholder="Explain why the answer is correct"></textarea>
          </div>

          <div class="row g-2">
            <div class="col-6">
              <label class="form-label">X (%)</label>
              <input id="timedQuizPosX" type="number" min="0" max="100" step="0.1" class="form-control form-control-sm" value="93">
            </div>
            <div class="col-6">
              <label class="form-label">Y (%)</label>
              <input id="timedQuizPosY" type="number" min="0" max="100" step="0.1" class="form-control form-control-sm" value="12">
            </div>
          </div>
          <p class="small text-muted mt-2 mb-0">Drag the marker on video to set quiz icon position.</p>

          <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="timedQuizPauseOnShow">
            <label class="form-check-label" for="timedQuizPauseOnShow">Pause video when quiz appears</label>
          </div>
        </div>

        <div class="timed-quiz-panel-actions">
          <button id="timedQuizResetBtn" class="btn btn-sm btn-outline-secondary" type="button">Reset</button>
          <button id="timedQuizSaveBtn" class="btn btn-sm btn-primary" type="button">Save Quiz</button>
        </div>
      </div>
      <div id="timedQuizList" class="quiz-list"></div>
    </aside>
  </div>
</div>

<script id="video-settings-data" type="application/json">
  <%- serializeJson({
    courseId: String(course._id),
    sectionIndex: Number(sectionIndex),
    lessonIndex: Number(lessonIndex),
    lessonName: lesson.title || '',
    videoUrl: videoUrl || '',
    videoId: videoId || '',
    interactiveQuizzes: interactiveQuizzes || []
  }) %>
</script>
<script src="/javascripts/admin/video-settings.js" defer></script>
