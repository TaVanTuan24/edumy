# ============================
# Edumy Environment Variables
# ============================

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/edumy

# Session secret (REQUIRED in production - must be a strong random string)
SESSION_SECRET=change-me-to-a-strong-random-secret

# CSRF secret (optional - falls back to SESSION_SECRET if not set)
CSRF_SECRET=

# Server configuration
PORT=3000
HOST=0.0.0.0

# Global baseline rate limit.
# Defaults: disabled in development, 1200 requests / 15 min per IP in production.
# Set GLOBAL_RATE_LIMIT_MAX=0 to disable the global limiter.
GLOBAL_RATE_LIMIT_MAX=
GLOBAL_RATE_LIMIT_WINDOW_MS=900000

# Admin access (comma-separated emails and/or MongoDB ObjectIDs)
ADMIN_EMAILS=admin@example.com
ADMIN_USER_IDS=

# CORS origins (production only)
CORS_ORIGIN=
BASE_URL=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# User-defined BYOK AI configuration
# Required in production to encrypt user API keys at rest.
# Generate with: openssl rand -hex 32
USER_AI_KEY_ENCRYPTION_SECRET=

# Optional admin/dev fallback. Disabled unless ALLOW_GLOBAL_AI_FALLBACK=true.
ALLOW_GLOBAL_AI_FALLBACK=false
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_SUMMARY_MODEL=

# Chat message limit per document (default: 200)
MAX_CHAT_MESSAGES=200

# AI cache settings (in-memory, for multi-instance see docs)
AI_CACHE_MAX_ENTRIES=100
AI_CACHE_TTL_MS=600000

# Analytics event tracking
ANALYTICS_ENABLED=true
ANALYTICS_METADATA_MAX_BYTES=10240
VIDEO_PROGRESS_THROTTLE_MS=30000

# Grok (optional)
GROK_ENABLED=false
