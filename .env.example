# ============================
# Edumy Environment Variables
# ============================

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/edumy

# MongoDB connection tuning (optional)
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
# Set to false only if indexes are provisioned out-of-band (default: true, needed for unique constraints)
MONGO_AUTO_INDEX=true

# Session secret (REQUIRED in production - must be a strong random string)
SESSION_SECRET=change-me-to-a-strong-random-secret

# CSRF secret (optional - falls back to SESSION_SECRET if not set)
CSRF_SECRET=

# JWT secret for VR device tokens. Strongly recommended in production so the JWT signing key is
# independent from SESSION_SECRET. Falls back to SESSION_SECRET if unset (logs a warning).
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Server configuration
PORT=3000
HOST=0.0.0.0

# Global baseline rate limit.
# Defaults: disabled in development, 1200 requests / 15 min per IP in production.
# Set GLOBAL_RATE_LIMIT_MAX=0 to disable the global limiter.
GLOBAL_RATE_LIMIT_MAX=
GLOBAL_RATE_LIMIT_WINDOW_MS=900000

# Admin access (comma-separated emails and/or MongoDB ObjectIDs)
ADMIN_EMAILS=admin@example.com
ADMIN_USER_IDS=

# CORS origins (production only)
CORS_ORIGIN=
BASE_URL=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# User-defined BYOK AI configuration
# Required in production to encrypt user API keys at rest.
# Generate with: openssl rand -hex 32
USER_AI_KEY_ENCRYPTION_SECRET=

# Optional admin/dev fallback. Disabled unless ALLOW_GLOBAL_AI_FALLBACK=true.
ALLOW_GLOBAL_AI_FALLBACK=false
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_SUMMARY_MODEL=

# Chat message limit per document (default: 200)
MAX_CHAT_MESSAGES=200

# AI cache settings (in-memory, for multi-instance see docs)
AI_CACHE_MAX_ENTRIES=100
AI_CACHE_TTL_MS=600000

# Analytics event tracking
ANALYTICS_ENABLED=true
ANALYTICS_METADATA_MAX_BYTES=10240
VIDEO_PROGRESS_THROTTLE_MS=30000

# Grok (optional)
GROK_ENABLED=false

# ---- YouTube Transcript Service ----
# Enable verbose logging for transcript fetching strategies
TRANSCRIPT_DEBUG=false
# Timeout per strategy attempt in ms (default: 30000)
TRANSCRIPT_FETCH_TIMEOUT_MS=30000
# Proxy URL for yt-dlp (e.g. socks5://host:1080) — useful if YouTube blocks your server IP
YOUTUBE_PROXY_URL=
# Path to a Netscape cookies.txt file for yt-dlp (bypasses bot detection)
YTDLP_COOKIES_PATH=
# Override yt-dlp binary path (default: yt-dlp)
YTDLP_PATH=

# ---- VR Stream Resolver ----
# Path to a pre-installed yt-dlp binary used by the VR stream resolver.
VR_STREAM_YTDLP_PATH=
# Allow the server to fetch/install the yt-dlp toolchain at runtime (download the binary from
# GitHub or bootstrap a Python venv + pip install). Disabled in production by default; ship a
# pre-installed yt-dlp in the image instead. Set to 'true' to force-enable, 'false' to force-disable.
VR_STREAM_ALLOW_RUNTIME_BOOTSTRAP=
# Legacy switch to skip only the managed GitHub binary download.
VR_STREAM_SKIP_YTDLP_DOWNLOAD=
